+        const u64 mask = sf ? ~u64{0} : 0xFFFFFFFFULL;
+        const u64 b = sub ? (~imm & mask) : imm;
+        const u64 carry_in = sub ? 1 : 0;
+        const u64 am = a & mask;
+        const unsigned __int128 wide = static_cast<unsigned __int128>(am) + b + carry_in;
+        const u64 result = static_cast<u64>(wide) & mask;
+        if (setf) {
+            const int bits = sf ? 64 : 32;
+            const bool n = (result >> (bits - 1)) & 1, z = result == 0;
+            const bool c = sf ? (wide >> 64) != 0 : ((wide >> 32) & 1) != 0;
+            const bool sa = (am >> (bits - 1)) & 1, sb = (b >> (bits - 1)) & 1;

From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Nikita Sokolsky <sokolx@gmail.com>
Date: Thu, 19 Nov 2026 03:45:58 -0800
Subject: [PATCH] Merge MoltenVK PR #2901 (frankea): Compile pipeline cache
 shader libraries when they are first used

Applied from a diff of the pull request against this tree (2026-11-17).

Co-Authored-By: Claude Fable 5.2 <noreply@anthropic.com>
---
 MoltenVK/MoltenVK/GPUObjects/MVKPipeline.mm   |  2 +-
 .../MoltenVK/GPUObjects/MVKShaderModule.h     | 14 +++-
 .../MoltenVK/GPUObjects/MVKShaderModule.mm    | 71 ++++++++++++++++---
 MoltenVK/MoltenVK/Utility/MVKBaseObject.h     | 12 ++--
 4 files changed, 84 insertions(+), 15 deletions(-)

diff --git a/MoltenVK/MoltenVK/GPUObjects/MVKPipeline.mm b/MoltenVK/MoltenVK/GPUObjects/MVKPipeline.mm
index 5d761cb4..1eb6c035 100644
--- a/MoltenVK/MoltenVK/GPUObjects/MVKPipeline.mm
+++ b/MoltenVK/MoltenVK/GPUObjects/MVKPipeline.mm
@@ -2623,7 +2623,7 @@ static void setDepthClipConfig(SPIRVToMSLConversionConfiguration& shaderConfig,
 	MVKShaderLibraryCache* slCache = getShaderLibraryCache(shaderModule->getKey());
 	MVKShaderLibrary* shLib = slCache->getShaderLibrary(pContext, shaderModule, pipeline, &wasAdded, pShaderFeedback, startTime);
 	if (wasAdded) { markDirty(); }
-	else if (pShaderFeedback) { mvkEnableFlags(pShaderFeedback->flags, VK_PIPELINE_CREATION_FEEDBACK_APPLICATION_PIPELINE_CACHE_HIT_BIT); }
+	else if (shLib && pShaderFeedback) { mvkEnableFlags(pShaderFeedback->flags, VK_PIPELINE_CREATION_FEEDBACK_APPLICATION_PIPELINE_CACHE_HIT_BIT); }
 	return shLib;
 }
 
diff --git a/MoltenVK/MoltenVK/GPUObjects/MVKShaderModule.h b/MoltenVK/MoltenVK/GPUObjects/MVKShaderModule.h
index 94fc54d7..cb533609 100644
--- a/MoltenVK/MoltenVK/GPUObjects/MVKShaderModule.h
+++ b/MoltenVK/MoltenVK/GPUObjects/MVKShaderModule.h
@@ -24,6 +24,7 @@
 #include "MVKSmallVector.h"
 #include <MoltenVKShaderConverter/SPIRVToMSLConverter.h>
 #include <mutex>
+#include <atomic>
 
 #import <Metal/Metal.h>
 
@@ -119,8 +120,9 @@ public:
 					 const mvk::SPIRVToMSLConversionResult& conversionResult);
 
 	/**
-	 * When specializationMacroDef is not null, creates a macro-specialized library
-	 * specializationMacroDef contains (specialization id, value) mappings, should be sorted
+	 * Creates a library from MSL read from a pipeline cache. When specializationMacroDef is null, the MSL is
+	 * compiled on the first call to getMTLFunction(). When it is not null, a macro-specialized library is
+	 * compiled immediately; specializationMacroDef contains sorted (specialization id, value) mappings.
 	 */
 	MVKShaderLibrary(MVKVulkanAPIDeviceObject* owner,
 					 const mvk::SPIRVToMSLConversionResultInfo& resultInfo,
@@ -151,6 +153,7 @@ protected:
 						const std::vector<std::pair<uint32_t, MVKShaderMacroValue> >* specializationMacroDef = nullptr);
 	void compressMSL(const std::string& msl);
 	void decompressMSL(std::string& msl);
+	void ensureCompiled(VkPipelineCreationFeedback* pShaderFeedback);
 	MVKCompressor<std::string>& getCompressedMSL() { return _compressedMSL; }
 
 	MVKVulkanAPIDeviceObject* _owner;
@@ -158,6 +161,12 @@ protected:
 	MVKCompressor<std::string> _compressedMSL;
 	mvk::SPIRVToMSLConversionResultInfo _shaderConversionResultInfo;
 
+	/** When true, the library was read from a pipeline cache and its MSL has not been compiled yet */
+	std::atomic<bool> _compilePending{false};
+	/** When true, the deferred compile of the cached MSL failed and the library must be converted again */
+	std::atomic<bool> _compileFailed{false};
+	mutable std::mutex _compileLock;
+
 	/** When true, representing a library created with source, but never specialized */
 	bool _maySpecializeWithMacro;
 	/** Can only be populated when _maySpecializeWithMacro is true */
@@ -211,6 +220,7 @@ protected:
 
 	MVKVulkanAPIDeviceObject* _owner;
 	MVKSmallVector<std::pair<mvk::SPIRVToMSLConversionConfiguration, MVKShaderLibrary*>> _shaderLibraries;
+	std::vector<MVKShaderLibrary*> _retiredLibraries;
 };
 
 
diff --git a/MoltenVK/MoltenVK/GPUObjects/MVKShaderModule.mm b/MoltenVK/MoltenVK/GPUObjects/MVKShaderModule.mm
index c13acc4a..7c544bb3 100644
--- a/MoltenVK/MoltenVK/GPUObjects/MVKShaderModule.mm
+++ b/MoltenVK/MoltenVK/GPUObjects/MVKShaderModule.mm
@@ -121,10 +121,8 @@ static uint32_t getWorkgroupDimensionSize(const SPIRVWorkgroupSizeDimension& wgD
 												VkPipelineCreationFeedback* pShaderFeedback,
 												MVKShaderModule* shaderModule) {
 
-	if ( !_mtlLibrary ) { return MVKMTLFunctionNull; }
-	{ std::lock_guard<std::mutex> lk(mvkDiagLock); mvkDiagLastLibOverridden = mvkDiagLibs.count((void*)_mtlLibrary) != 0; }
-
-	id<MTLLibrary> lib = _mtlLibrary;
+	id<MTLLibrary> lib = nil;
+	bool usesMacroVariant = false;
 
 	// If specialization happens on constants mapped to macro, find or compile a library variant
 	// with proper macro definition instead of the "generic" library
@@ -145,6 +143,7 @@ static uint32_t getWorkgroupDimensionSize(const SPIRVWorkgroupSizeDimension& wgD
 		}
 
 		if (!spec_list.empty()) {
+			usesMacroVariant = true;
 			// Sort the specialization list before it is used as a key to index the variants
 			std::sort(spec_list.begin(), spec_list.end());
 			auto entry = _specializationVariants.find(spec_list);
@@ -158,6 +157,14 @@ static uint32_t getWorkgroupDimensionSize(const SPIRVWorkgroupSizeDimension& wgD
 		}
 	}
 
+	if ( !usesMacroVariant ) {
+		ensureCompiled(pShaderFeedback);
+		lib = _mtlLibrary;
+	}
+	if ( !lib ) { return MVKMTLFunctionNull; }
+	// (path-60 diag, moved below the deferred compile: the library exists only now)
+	{ std::lock_guard<std::mutex> lk(mvkDiagLock); mvkDiagLastLibOverridden = mvkDiagLibs.count((void*)lib) != 0; }
+
 
 	@synchronized (getMTLDevice()) {
 		@autoreleasepool {
@@ -267,13 +274,32 @@ static uint32_t getWorkgroupDimensionSize(const SPIRVWorkgroupSizeDimension& wgD
 	_owner(owner),
 	_maySpecializeWithMacro(specializationMacroDef == nullptr) {
 
+	_mtlLibrary = nil;
 	_shaderConversionResultInfo = resultInfo;
 	_compressedMSL = compressedMSL;
+	if ( !specializationMacroDef ) {
+		_compilePending.store(true, std::memory_order_release);
+		return;
+	}
 	string msl;
 	decompressMSL(msl);
 	compileLibrary(msl, specializationMacroDef);
 }
 
+// Compiles the MSL of a library read from a pipeline cache the first time one of its functions is needed.
+void MVKShaderLibrary::ensureCompiled(VkPipelineCreationFeedback* pShaderFeedback) {
+	if ( !_compilePending.load(std::memory_order_acquire) ) { return; }
+	lock_guard<mutex> lock(_compileLock);
+	if ( !_compilePending.load(std::memory_order_relaxed) ) { return; }
+	uint64_t startTime = mvkGetTimestamp();
+	string msl;
+	decompressMSL(msl);
+	compileLibrary(msl);
+	if (pShaderFeedback) { pShaderFeedback->duration += mvkGetElapsedNanoseconds(startTime); }
+	if ( !_mtlLibrary ) { _compileFailed.store(true, std::memory_order_release); }
+	_compilePending.store(false, std::memory_order_release);
+}
+
 void MVKShaderLibrary::compileLibrary(const string& msl,
 									  const vector<pair<uint32_t, MVKShaderMacroValue> >* specializationMacroDef) {
 	MVKShaderLibraryCompiler* slc = new MVKShaderLibraryCompiler(_owner);
@@ -362,12 +388,19 @@ static uint32_t getWorkgroupDimensionSize(const SPIRVWorkgroupSizeDimension& wgD
 	_maySpecializeWithMacro(other._maySpecializeWithMacro),
 	_specializationVariants(other._specializationVariants) {
 
+	lock_guard<mutex> lock(other._compileLock);
+	_compilePending.store(other._compilePending.load(std::memory_order_acquire), std::memory_order_relaxed);
+	_compileFailed.store(other._compileFailed.load(std::memory_order_acquire), std::memory_order_relaxed);
 	_mtlLibrary = [other._mtlLibrary retain];
 	_shaderConversionResultInfo = other._shaderConversionResultInfo;
 	_compressedMSL = other._compressedMSL;
 }
 
 MVKShaderLibrary& MVKShaderLibrary::operator=(const MVKShaderLibrary& other) {
+	if (this == &other) { return *this; }
+	scoped_lock lock(_compileLock, other._compileLock);
+	_compilePending.store(other._compilePending.load(std::memory_order_acquire), std::memory_order_relaxed);
+	_compileFailed.store(other._compileFailed.load(std::memory_order_acquire), std::memory_order_relaxed);
 	if (_mtlLibrary != other._mtlLibrary) {
 		[_mtlLibrary release];
 		_mtlLibrary = [other._mtlLibrary retain];
@@ -411,11 +444,23 @@ static uint32_t getWorkgroupDimensionSize(const SPIRVWorkgroupSizeDimension& wgD
 														  bool* pWasAdded, VkPipelineCreationFeedback* pShaderFeedback,
 														  uint64_t startTime) {
 	bool wasAdded = false;
+	bool failOnCompile = pipeline->shouldFailOnPipelineCompileRequired();
+	MVKShaderLibrary* retired = nullptr;
 	MVKShaderLibrary* shLib = findShaderLibrary(pShaderConfig, pShaderFeedback, startTime);
-	if ( !shLib && !pipeline->shouldFailOnPipelineCompileRequired() ) {
+	if (shLib && failOnCompile && shLib->_compilePending.load(std::memory_order_acquire)) { shLib = nullptr; }
+	if (shLib && shLib->_compileFailed.load(std::memory_order_acquire)) { retired = shLib; shLib = nullptr; }
+	if ( !shLib && !failOnCompile ) {
 		SPIRVToMSLConversionResult conversionResult;
 		if (shaderModule->convert(pShaderConfig, conversionResult)) {
-			shLib = addShaderLibrary(pShaderConfig, conversionResult);
+			if (retired) {
+				shLib = new MVKShaderLibrary(_owner, conversionResult);
+				for (auto& slPair : _shaderLibraries) {
+					if (slPair.second == retired) { slPair.second = shLib; break; }
+				}
+				_retiredLibraries.push_back(retired);
+			} else {
+				shLib = addShaderLibrary(pShaderConfig, conversionResult);
+			}
 			if (pShaderFeedback) {
 				pShaderFeedback->duration += mvkGetElapsedNanoseconds(startTime);
 			}
@@ -476,6 +521,7 @@ static uint32_t getWorkgroupDimensionSize(const SPIRVWorkgroupSizeDimension& wgD
 
 MVKShaderLibraryCache::~MVKShaderLibraryCache() {
 	for (auto& slPair : _shaderLibraries) { slPair.second->destroy(); }
+	for (auto* lib : _retiredLibraries) { lib->destroy(); }
 }
 
 
@@ -487,8 +533,9 @@ static uint32_t getWorkgroupDimensionSize(const SPIRVWorkgroupSizeDimension& wgD
 											   MVKPipeline* pipeline,
 											   VkPipelineCreationFeedback* pShaderFeedback) {
 	MVKShaderLibrary* mvkLib = _directMSLLibrary;
+	MVKPipelineCache* pipelineCache = nullptr;	// PR 2901: also used to retry a deferred compile that failed
 	if ( !mvkLib ) {
-		MVKPipelineCache* pipelineCache = pipeline->getPipelineCache();
+		pipelineCache = pipeline->getPipelineCache();
 		auto getLib = [&]() {
 			uint64_t startTime = pShaderFeedback ? mvkGetTimestamp() : getPerformanceTimestamp();
 			if (pipelineCache) { return pipelineCache->getShaderLibrary(pShaderConfig, this, pipeline, pShaderFeedback, startTime); }
@@ -511,7 +558,15 @@ static uint32_t getWorkgroupDimensionSize(const SPIRVWorkgroupSizeDimension& wgD
 		pShaderConfig->markAllInterfaceVarsAndResourcesUsed();
 	}
 
-	return mvkLib ? mvkLib->getMTLFunction(pSpecializationInfo, pShaderFeedback, this) : MVKMTLFunctionNull;
+	if ( !mvkLib ) { return MVKMTLFunctionNull; }
+	MVKMTLFunction mtlFunc = mvkLib->getMTLFunction(pSpecializationInfo, pShaderFeedback, this);
+	if ( !mtlFunc.getMTLFunction() && pipelineCache && mvkLib->_compileFailed.load(std::memory_order_acquire) ) {
+		uint64_t startTime = pShaderFeedback ? mvkGetTimestamp() : getPerformanceTimestamp();
+		if (pShaderFeedback) { mvkDisableFlags(pShaderFeedback->flags, VK_PIPELINE_CREATION_FEEDBACK_APPLICATION_PIPELINE_CACHE_HIT_BIT); }
+		mvkLib = pipelineCache->getShaderLibrary(pShaderConfig, this, pipeline, pShaderFeedback, startTime);
+		if (mvkLib) { mtlFunc = mvkLib->getMTLFunction(pSpecializationInfo, pShaderFeedback, this); }
+	}
+	return mtlFunc;
 }
 
 bool MVKShaderModule::convert(SPIRVToMSLConversionConfiguration* pShaderConfig,
diff --git a/MoltenVK/MoltenVK/Utility/MVKBaseObject.h b/MoltenVK/MoltenVK/Utility/MVKBaseObject.h
index d9e04de1..8c025115 100644
--- a/MoltenVK/MoltenVK/Utility/MVKBaseObject.h
+++ b/MoltenVK/MoltenVK/Utility/MVKBaseObject.h
@@ -196,11 +196,15 @@ class MVKConfigurableMixin {
 public:
 
 	/** Returns a indication of the success of the configuration of this instance. */
-	VkResult getConfigurationResult() { return _configurationResult; }
+	VkResult getConfigurationResult() { return _configurationResult.load(); }
 
-	/** If the existing configuration result is VK_SUCCESS, it is set to the specified value. */
+	/**
+	 * If the existing configuration result is VK_SUCCESS, it is set to the specified value.
+	 * This can be called from several threads, such as by shader compiles deferred until first use.
+	 */
 	void setConfigurationResult(VkResult vkResult) {
-		if (_configurationResult == VK_SUCCESS) { _configurationResult = vkResult; }
+		VkResult expected = VK_SUCCESS;
+		_configurationResult.compare_exchange_strong(expected, vkResult);
 	}
 
 	/** Returns whether the configuration was successful. */
@@ -210,7 +214,7 @@ public:
 	void clearConfigurationResult() { _configurationResult = VK_SUCCESS; }
 
 protected:
-	VkResult _configurationResult = VK_SUCCESS;
+	std::atomic<VkResult> _configurationResult{VK_SUCCESS};
 };
 
 

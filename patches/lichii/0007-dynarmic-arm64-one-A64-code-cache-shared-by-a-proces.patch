+bool BranchReaches(CodePtr from, CodePtr to, std::size_t reach) {
+    const std::ptrdiff_t distance = to - from;
+    return distance >= -static_cast<std::ptrdiff_t>(reach) && distance < static_cast<std::ptrdiff_t>(reach);

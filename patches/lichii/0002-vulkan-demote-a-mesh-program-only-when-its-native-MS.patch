From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Nikita Sokolsky <sokolx@gmail.com>
Date: Thu, 19 Nov 2026 03:45:04 -0800
Subject: [PATCH] vulkan: demote a mesh program only when its native MSL
 threadgroup memory exceeds the device limit

Local change on top of PR #1970 (was commit 9537add839).

Co-Authored-By: Claude Fable 5.2 <noreply@anthropic.com>
---
 .../renderer_vulkan/mesh_fallback_limits.h    | 96 +++++++++++++++++++
 .../renderer_vulkan/vk_pipeline_cache.cpp     | 80 +++++++++-------
 2 files changed, 141 insertions(+), 35 deletions(-)

diff --git a/src/video_core/renderer_vulkan/mesh_fallback_limits.h b/src/video_core/renderer_vulkan/mesh_fallback_limits.h
index 42e4107dd6..cd1de34b3a 100644
--- a/src/video_core/renderer_vulkan/mesh_fallback_limits.h
+++ b/src/video_core/renderer_vulkan/mesh_fallback_limits.h
@@ -3,9 +3,11 @@
 #pragma once
 
 #include <algorithm>
+#include <array>
 #include <cstddef>
 #include <cstdint>
 
+#include "shader_recompiler/frontend/ir/attribute.h"
 #include "shader_recompiler/frontend/ir/program.h"
 #include "shader_recompiler/profile.h"
 
@@ -78,6 +80,100 @@ struct WorkgroupMemoryLayout {
     return layout.size;
 }
 
+/// Threadgroup memory a native mesh program takes once MoltenVK has turned its SPIR-V into MSL,
+/// by part. Metal fails the pipeline when the total exceeds maxThreadgroupMemoryLength (32 KiB
+/// on Apple GPUs). It counts every `threadgroup` variable the MSL entry point declares:
+///  - Lichii's own workgroup variables (EmitContext::DefineMesh / DefineSharedMemory): the ISBE
+///    output region (isbe_attributes), the map region (isbe_map), the primitive count, and the
+///    guest's shared memory (plus a lock word for 64-bit shared exchange);
+///  - SPIRV-Cross's staged mesh outputs: Metal's mesh API takes outputs per vertex/primitive
+///    through set_vertex/set_primitive, so SPIRV-Cross declares every Output array as a
+///    threadgroup array and copies it out at the end. Every generic is a float4 (16 B) per vertex
+///    or primitive, Position a float4, PointSize a float, per-primitive builtins a uint each, and
+///    the index array one uint/uint2/uint3 (4/8/16 B) per primitive;
+///  - spvMeshSizes (uint2) that SPIRV-Cross adds for SetMeshOutputsEXT.
+/// The task payload is object_data in MSL, not threadgroup memory, so it is not counted.
+struct NativeMeshThreadgroupMemory {
+    std::uint64_t isbe{};    ///< isbe_attributes + isbe_map + isbe_primitive_count
+    std::uint64_t outputs{}; ///< SPIRV-Cross's staged Output arrays, with the index array
+    std::uint64_t shared{};  ///< guest shared memory and its atomic lock
+    std::uint64_t fixed{};   ///< spvMeshSizes
+
+    [[nodiscard]] constexpr std::uint64_t Total() const noexcept {
+        return isbe + outputs + shared + fixed;
+    }
+};
+
+[[nodiscard]] inline NativeMeshThreadgroupMemory NativeMeshThreadgroupMemorySize(
+    const Shader::IR::Program& program, const Shader::Profile& profile) {
+    NativeMeshThreadgroupMemory result;
+    if (program.stage != Shader::Stage::Mesh) {
+        return result;
+    }
+    const Shader::MeshInfo& mesh{program.mesh};
+    const auto div_ceil = [](std::uint64_t value, std::uint64_t divisor) {
+        return (value + divisor - 1) / divisor;
+    };
+    constexpr std::uint64_t word{sizeof(std::uint32_t)};
+    // DefineMesh: the same arrays the emulation uses (MeshFallbackWorkgroupMemorySize).
+    const std::uint64_t attribute_words{(std::max)(
+        div_ceil(mesh.max_vertices, 32) * mesh.vertex_lines.size() * 32 +
+            div_ceil(mesh.max_primitives, 32) * mesh.primitive_lines.size() * 32,
+        std::uint64_t{1})};
+    const std::uint64_t map_elements{
+        4 + static_cast<std::uint64_t>(mesh.PrimitiveVertices()) * mesh.max_primitives};
+    result.isbe = (attribute_words + map_elements + 1) * word;
+
+    // DefineMesh's Output variables, one per generic index (per vertex and per primitive), as
+    // SPIRV-Cross stages them.
+    const std::uint64_t vertices{mesh.max_vertices};
+    const std::uint64_t primitives{mesh.max_primitives};
+    std::uint64_t outputs{};
+    std::array<bool, Shader::IR::NUM_GENERICS> vertex_generic{}, primitive_generic{};
+    bool position{}, point_size{mesh.PrimitiveVertices() == 1};
+    bool primitive_id{}, layer{}, viewport{};
+    for (const std::uint32_t line : mesh.vertex_lines) {
+        const Shader::IR::Attribute attribute{line};
+        if (Shader::IR::IsGeneric(attribute)) {
+            vertex_generic[Shader::IR::GenericAttributeIndex(attribute)] = true;
+        } else if (attribute >= Shader::IR::Attribute::PositionX &&
+                   attribute <= Shader::IR::Attribute::PositionW) {
+            position = true;
+        } else if (attribute == Shader::IR::Attribute::PointSize) {
+            point_size = true;
+        }
+    }
+    for (const std::uint32_t line : mesh.primitive_lines) {
+        const Shader::IR::Attribute attribute{line};
+        if (Shader::IR::IsGeneric(attribute)) {
+            primitive_generic[Shader::IR::GenericAttributeIndex(attribute)] = true;
+        } else if (attribute == Shader::IR::Attribute::PrimitiveId) {
+            primitive_id = true;
+        } else if (attribute == Shader::IR::Attribute::Layer) {
+            layer = true;
+        } else if (attribute == Shader::IR::Attribute::ViewportIndex) {
+            viewport = true;
+        }
+    }
+    for (std::size_t index = 0; index < vertex_generic.size(); ++index) {
+        outputs += (vertex_generic[index] ? vertices * 16 : 0) +
+                   (primitive_generic[index] ? primitives * 16 : 0);
+    }
+    outputs += (position ? vertices * 16 : 0) + (point_size ? vertices * 4 : 0);
+    outputs += (std::uint64_t{primitive_id} + layer + viewport) * primitives * 4;
+    const std::uint32_t primitive_vertices{mesh.PrimitiveVertices()};
+    outputs += primitives * (primitive_vertices == 1 ? 4 : primitive_vertices == 2 ? 8 : 16);
+    result.outputs = outputs;
+
+    // DefineSharedMemory without an explicit layout (always so for mesh programs).
+    if (program.shared_memory_size != 0) {
+        result.shared = div_ceil(program.shared_memory_size, word) * word +
+                        SharedAtomicExchange64LockSize(program, profile, false);
+    }
+    result.fixed = 2 * word; // spvMeshSizes
+    return result;
+}
+
 // The mesh fallback adds storage-buffer bindings for its output (mesh-only), or
 // output, task payload, offsets and indirect arguments (task + mesh). Check
 // against the final descriptor set limit without overflowing guest + auxiliary.
diff --git a/src/video_core/renderer_vulkan/vk_pipeline_cache.cpp b/src/video_core/renderer_vulkan/vk_pipeline_cache.cpp
index d06cefcc29..30d6ddca9f 100644
--- a/src/video_core/renderer_vulkan/vk_pipeline_cache.cpp
+++ b/src/video_core/renderer_vulkan/vk_pipeline_cache.cpp
@@ -439,6 +439,17 @@ std::vector<u32> EmitStageSpirv(const Device& device, const Shader::Profile& pro
                                 std::span<const u32> reference = {}) {
     auto code = EmitPipelineShader(profile, runtime_info, program, binding, shader_hash, reference);
     device.SaveShader(code);
+    if (program.stage == Shader::Stage::Mesh && !runtime_info.mesh_as_compute) {
+        // MoltenVK names its MVK_CONFIG_SHADER_DUMP_DIR files and errors by this hash (mvkHash).
+        size_t mvk_hash{5381};
+        for (const u32 word : code) {
+            mvk_hash = ((mvk_hash << 5) + mvk_hash) ^ word;
+        }
+        LOG_INFO(Render_Vulkan,
+                 "Mesh fallback: native mesh program {:016x} is MoltenVK shader {:016x}, "
+                 "predicted {} B threadgroup memory",
+                 shader_hash, mvk_hash, NativeMeshThreadgroupMemorySize(program, profile).Total());
+    }
 
     // Text log + .spv dump. Text log is gated by gpu_log_level != Off; .spv dump
     // is independent and gated only by gpu_log_shader_dumps.
@@ -2837,9 +2848,17 @@ std::unique_ptr<GraphicsPipeline> PipelineCache::CreateGraphicsPipeline(
     // Experiment: EDEN_NX2_MESH_NATIVE_ALWAYS=1 hands every mesh pipeline to the driver.
     static const bool native_always{std::getenv("EDEN_NX2_MESH_NATIVE_ALWAYS") != nullptr};
     if (!native_always && !mesh_unsupported && device.IsExtMeshShaderSupported()) {
-        // Programs that need more workgroup memory than the device has take mesh emulation:
-        // MoltenVK keeps mesh outputs in threadgroup memory next to shared variables, and an
-        // Apple GPU's 32 KiB hold less than Switch 2 programs use.
+        // Programs whose native form needs more threadgroup memory than the device has take mesh
+        // emulation. The limit is the real one (Metal's 32 KiB on Apple GPUs), not MoltenVK's
+        // reported mesh shared/output sizes: those are a fixed share of it and demote programs
+        // that fit. NativeMeshThreadgroupMemorySize adds up what the MSL will declare.
+        // EDEN_NX2_MESH_TG_LIMIT=<bytes> overrides the limit for testing.
+        static const u64 limit_override{[] {
+            const char* const value{std::getenv("EDEN_NX2_MESH_TG_LIMIT")};
+            return value ? std::strtoull(value, nullptr, 0) : u64{0};
+        }()};
+        const u64 threadgroup_limit{limit_override != 0 ? limit_override
+                                                        : u64{device.GetMaxComputeSharedMemorySize()}};
         const auto& limits{device.GetMeshShaderProperties()};
         for (size_t index = 1; index < Maxwell::MaxShaderProgram && !mesh_unsupported; ++index) {
             const Shader::IR::Program& program{programs[index]};
@@ -2853,40 +2872,31 @@ std::unique_ptr<GraphicsPipeline> PipelineCache::CreateGraphicsPipeline(
                     lock_size == 0
                         ? program.shared_memory_size
                         : ((u64{program.shared_memory_size} + 3) & ~u64{3}) + lock_size};
-                mesh_unsupported =
-                    shared_memory_size > limits.maxTaskSharedMemorySize ||
-                    payload_bytes > limits.maxTaskPayloadSize ||
-                    payload_bytes + shared_memory_size >
-                        limits.maxTaskPayloadAndSharedMemorySize;
+                mesh_unsupported = shared_memory_size > threadgroup_limit ||
+                                   payload_bytes > limits.maxTaskPayloadSize;
+                if (mesh_unsupported) {
+                    LOG_INFO(Render_Vulkan,
+                             "Mesh fallback: pipeline {:016x} task program {:016x} needs {} B "
+                             "threadgroup memory and a {} B payload (limits {} B / {} B); "
+                             "emulating",
+                             hash, key.unique_hashes[index], shared_memory_size, payload_bytes,
+                             threadgroup_limit, limits.maxTaskPayloadSize);
+                }
             } else if (program.stage == Shader::Stage::Mesh) {
-                constexpr u64 LineBytes = 16;
-                const u64 outputs{program.mesh.max_vertices * program.mesh.vertex_lines.size() *
-                                      LineBytes +
-                                  program.mesh.max_primitives *
-                                      program.mesh.primitive_lines.size() * LineBytes};
-                const bool has_task{key.unique_hashes[1] != 0 &&
-                                    programs[1].stage == Shader::Stage::Task};
-                const u64 payload_bytes =
-                    has_task ? u64{programs[1].mesh.payload_words} * sizeof(u32) : 0;
-                const u64 lock_size{SharedAtomicExchange64LockSize(program, profile, false)};
-                const u64 shared_memory_size{
-                    lock_size == 0
-                        ? program.shared_memory_size
-                        : ((u64{program.shared_memory_size} + 3) & ~u64{3}) + lock_size};
-                mesh_unsupported =
-                    program.mesh.max_vertices > limits.maxMeshOutputVertices ||
-                    program.mesh.max_primitives > limits.maxMeshOutputPrimitives ||
-                    shared_memory_size > limits.maxMeshSharedMemorySize ||
-                    outputs > limits.maxMeshOutputMemorySize ||
-                    payload_bytes + shared_memory_size >
-                        limits.maxMeshPayloadAndSharedMemorySize ||
-                    payload_bytes + outputs > limits.maxMeshPayloadAndOutputMemorySize;
-            }
-            if (mesh_unsupported) {
+                const NativeMeshThreadgroupMemory memory{
+                    NativeMeshThreadgroupMemorySize(program, profile)};
+                mesh_unsupported = program.mesh.max_vertices > limits.maxMeshOutputVertices ||
+                                   program.mesh.max_primitives > limits.maxMeshOutputPrimitives ||
+                                   memory.Total() > threadgroup_limit;
                 LOG_INFO(Render_Vulkan,
-                         "Pipeline {:016x}: program {:016x} needs more mesh workgroup memory than "
-                         "the device has ({} B shared); emulating its mesh stage",
-                         hash, key.unique_hashes[index], program.shared_memory_size);
+                         "Mesh fallback: pipeline {:016x} mesh program {:016x}: {} B threadgroup "
+                         "memory (isbe {} + outputs {} + shared {} + {}; {} vertices, {} "
+                         "primitives, {}+{} lines), limit {} B: {}",
+                         hash, key.unique_hashes[index], memory.Total(), memory.isbe,
+                         memory.outputs, memory.shared, memory.fixed, program.mesh.max_vertices,
+                         program.mesh.max_primitives, program.mesh.vertex_lines.size(),
+                         program.mesh.primitive_lines.size(), threadgroup_limit,
+                         mesh_unsupported ? "emulating" : "native");
             }
         }
     }

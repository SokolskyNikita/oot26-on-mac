index 7c544bb3..f17538a9 100644
--- a/MoltenVK/MoltenVK/GPUObjects/MVKShaderModule.mm
+++ b/MoltenVK/MoltenVK/GPUObjects/MVKShaderModule.mm
@@ -17,6 +17,8 @@
  */
 
 #include "MVKShaderModule.h"
+#include "MVKSlimTextureClasses.h"
+#include <atomic>
 #include "MVKPipeline.h"
 #include "MVKFoundation.h"
 #include <sys/stat.h>
@@ -708,6 +710,19 @@ static uint32_t getWorkgroupDimensionSize(const SPIRVWorkgroupSizeDimension& wgD
 #pragma mark -
 #pragma mark MVKShaderLibraryCompiler
 
+// MVK_P60_NO_SLIM_TEXTURES=1 compiles every library from the source as generated.
+static bool mvkSlimTextureClassesEnabled() {
+	static const bool on = !getenv("MVK_P60_NO_SLIM_TEXTURES");
+	return on;
+}
+
+// Counts the libraries that did not compile with slim texture classes. A source that compiles as
+// generated but not with them points at a standard library the pass does not fit.
+static uint32_t mvkSlimTextureClassesFailed() {
+	static std::atomic<uint32_t> failures{0};
+	return ++failures;
+}
+
 id<MTLLibrary> MVKShaderLibraryCompiler::newMTLLibrary(NSString* mslSourceCode,
 													   const SPIRVToMSLConversionResultInfo& shaderConversionResults,
 													   const vector<pair<MSLSpecializationMacroInfo, MVKShaderMacroValue>>& specializationMacroDef) {
@@ -733,9 +748,36 @@ static uint32_t getWorkgroupDimensionSize(const SPIRVWorkgroupSizeDimension& wgD
 				}
 				logCompilation(mtlCompileOptions);
 
-				[mtlDev newLibraryWithSource: mslSourceCode
+				// Compile with slim texture classes when the source uses any (MVKSlimTextureClasses.h),
+				// and with the source as generated if that fails to compile.
+				NSString* slimSourceCode = nil;
+				if (mvkSlimTextureClassesEnabled()) {
+					MTLLanguageVersion mslVer = mtlCompileOptions.languageVersion;
+					std::string slimSource;
+					if (mvkSlimTextureClasses(mslSourceCode.UTF8String, uint32_t((mslVer >> 16) * 100 + (mslVer & 0xffff) * 10), slimSource)) {
+						slimSourceCode = @(slimSource.c_str());
+					}
+				}
+
+				[mtlDev newLibraryWithSource: (slimSourceCode ? slimSourceCode : mslSourceCode)
 									options: mtlCompileOptions
 						completionHandler: ^(id<MTLLibrary> mtlLib, NSError* error) {
+							if ( !mtlLib && slimSourceCode ) {
+								uint32_t failures = mvkSlimTextureClassesFailed();
+								if (failures == 1) {
+									MVKLogInfo("Slim texture classes did not compile; using the MSL as generated for this library. First error:\n%s",
+											   error.localizedDescription.UTF8String);
+								} else if ((failures & (failures - 1)) == 0) {
+									MVKLogInfo("Slim texture classes did not compile for %u libraries so far.", failures);
+								}
+								[mtlDev newLibraryWithSource: mslSourceCode
+													options: mtlCompileOptions
+										completionHandler: ^(id<MTLLibrary> mtlLibAsGenerated, NSError* errorAsGenerated) {
+											bool isLate = compileComplete(mtlLibAsGenerated, errorAsGenerated);
+											if (isLate) { destroy(); }
+										}];
+								return;
+							}
 							bool isLate = compileComplete(mtlLib, error);
 							if (isLate) { destroy(); }
 						}];
diff --git a/MoltenVK/MoltenVK/Utility/MVKSlimTextureClasses.cpp b/MoltenVK/MoltenVK/Utility/MVKSlimTextureClasses.cpp
new file mode 100644
index 00000000..e3929cbf
--- /dev/null
+++ b/MoltenVK/MoltenVK/Utility/MVKSlimTextureClasses.cpp
@@ -0,0 +1,375 @@
+/*

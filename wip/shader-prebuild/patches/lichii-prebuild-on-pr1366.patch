index 0000000000..dc5ff39c55
--- /dev/null
+++ b/tools/nx2-precompile/py/state_model_static.py
@@ -0,0 +1,122 @@
+"""Render-state model for keys WITHOUT dynamic vertex input or extended dynamic state (MoltenVK, local).
+
+There the key's hash covers 432 bytes of FixedPipelineState: the 112-byte prefix, then the vertex
+attributes (128), binding divisors (128) and strides (64). A state is five parts, each drawn from the
+most specific history there is:
+  T  topology and vertex flags, point size           by vertex shader
+  L  vertex layout: enabled divisors, attributes, divisors, strides   by vertex shader
+  F  render target part (formats, blend, alpha test, msaa)            by pixel shader
+  D  dynamic_state (cull, depth and stencil: in the key with no extended dynamic state) by pixel shader
+  S  scene part (y negate, swizzles, ...)                             global
+Metal compiles a pipeline's vertex and fragment functions separately and caches each (measured:
+another blend or colour format recompiles the fragment function only, another stride or vertex
+function the vertex function only, another depth format nothing). So the candidates cover each
+part's likely values once, not their product.
+"""
+import collections
+import struct
+
+import statefields as sf
+
+STATE_LEN = 432
+
+
+def u32(b, o):
+    return struct.unpack_from('<I', b, o)[0]
+
+
+def canonical(state: bytes) -> bytes:
+    """The 432 hashed bytes, canonical as CanonicalizeNative leaves a static key: driver and unused
+    blend attachments cleared (the attribute bytes are kept: they are the enabled divisors)."""
+    return sf.canonical(state[:112], None) + state[112:STATE_LEN]
+
+
+def parts(state: bytes):
+    raw1, raw2 = u32(state, 0), u32(state, 4)
+    t = (raw1 & 0x0F0FFFC0, u32(state, 28))
+    l = (state[64:72], state[112:STATE_LEN])
+    f = (raw1 & 0xF0200000, raw2 & 0x000187FE, state[8:16], u32(state, 24), state[80:112])
+    d = state[72:80]
+    s = (raw1 & 0x0000003F, raw1 & 0x00100000, raw2 & 0xFFFE7801, state[32:64])
+    return t, l, f, d, s
+
+
+def assemble(t, l, f, d, s) -> bytes:
+    b = bytearray(STATE_LEN)
+    struct.pack_into('<II', b, 0, t[0] | f[0] | s[0] | s[1], f[1] | s[2])
+    b[8:16] = f[2]
+    struct.pack_into('<II', b, 24, f[3], t[1])
+    b[32:64] = s[3]
+    b[64:72] = l[0]
+    b[72:80] = d
+    b[80:112] = f[4]
+    b[112:STATE_LEN] = l[1]
+    return bytes(b)
+
+
+class Model:
+    W = {'own': 1.0, 'fine': 0.6, 'coarse': 0.25, 'class': 0.25, 'mask': 0.1, 'global': 0.04}
+
+    def __init__(self):
+        self.T = collections.defaultdict(collections.Counter)
+        self.L = collections.defaultdict(collections.Counter)
+        self.F = collections.defaultdict(collections.Counter)
+        self.D = collections.defaultdict(collections.Counter)
+        self.S = collections.Counter()
+
+    @staticmethod
+    def vkeys(vs, with_mask):
+        m = vs['read_mask'] if with_mask else None
+        return [('own', vs['hash']), ('fine', (vs['fine'], m)), ('coarse', (vs['coarse'], m)),
+                ('mask', m) if with_mask else ('global', ''), ('global', '')]
+
+    @staticmethod
+    def fkeys(fs):
+        return [('own', fs['hash']), ('fine', fs['fine']), ('coarse', fs['coarse']),
+                ('class', fs['pclass']), ('global', '')]
+
+    def add(self, vs, fs, state):
+        t, l, f, d, s = parts(state)
+        for k in self.vkeys(vs, False):
+            self.T[k][t] += 1
+        for k in self.vkeys(vs, True):
+            self.L[k][l] += 1
+        for k in self.fkeys(fs):
+            self.F[k][f] += 1
+            self.D[k][d] += 1
+        self.S[s] += 1
+
+    def _blend(self, table, keys, limit):
+        out = collections.Counter()
+        for lvl, key in keys:
+            c = table.get((lvl, key))
+            if not c:
+                continue
+            tot = sum(c.values())
+            for x, n in c.most_common(limit):
+                out[x] += self.W[lvl] * n / tot
+            if lvl == 'own':
+                break
+        return [x for x, _ in out.most_common(limit)]
+
+    def part_candidates(self, vs, fs, kt=2, kl=3, kf=4, kd=2):
+        return (self._blend(self.T, self.vkeys(vs, False), kt), self._blend(self.L, self.vkeys(vs, True), kl),
+                self._blend(self.F, self.fkeys(fs), kf), self._blend(self.D, self.fkeys(fs), kd),
+                [x for x, _ in self.S.most_common(1)])
+
+    def candidates(self, vs, fs, kt=2, kl=3, kf=4, kd=2):
+        """States covering each part's candidates once: the most likely state, then one part varied."""
+        ct, cl, cf, cd, cs = self.part_candidates(vs, fs, kt, kl, kf, kd)
+        if not (ct and cl and cf and cd and cs):
+            return []
+        out = [assemble(ct[0], cl[0], cf[0], cd[0], cs[0])]
+        out += [assemble(ct[0], cl[0], f, cd[0], cs[0]) for f in cf[1:]]
+        out += [assemble(ct[0], l, cf[0], cd[0], cs[0]) for l in cl[1:]]
+        out += [assemble(ct[0], cl[0], cf[0], d, cs[0]) for d in cd[1:]]
+        out += [assemble(t, cl[0], cf[0], cd[0], cs[0]) for t in ct[1:]]
+        seen, uniq = set(), []
+        for st in out:
+            if st not in seen:
+                seen.add(st)
+                uniq.append(st)
+        return uniq

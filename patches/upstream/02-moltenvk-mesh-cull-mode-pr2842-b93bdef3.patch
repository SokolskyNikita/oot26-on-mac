 	// Extract dynamic state first, as it can affect many configurations.
 	initDynamicState(pCreateInfo);
+	if (_isMeshPipeline) {
+		// The input assembly state does not exist for a mesh pipeline, so its dynamic forms have nothing to change.
+		_dynamicStateFlags.removeAll({ MVKRenderStateFlag::PrimitiveTopology, MVKRenderStateFlag::PrimitiveRestartEnable });
+	}
 
 	_primitiveTopologyClass = MTLPrimitiveTopologyClassUnspecified;
 	if (pCreateInfo->pInputAssemblyState)
@@ -887,6 +930,12 @@ static bool usesConstantColor(MVKRenderStateFlags dynamic, const VkPipelineColor
 		_vkPrimitiveTopology = pCreateInfo->pInputAssemblyState->topology;
 		primitiveRestart = pCreateInfo->pInputAssemblyState->primitiveRestartEnable;
 	}
+	if (_isMeshPipeline) {
+		// A mesh pipeline rasterizes what its mesh shader emits. Leaving the topology at the point-list default made
+		// the encoder state treat every mesh draw as "not triangles" and skip its cull mode and fill mode, so a mesh
+		// draw ran with whatever the previous draw had left on the Metal encoder.
+		_vkPrimitiveTopology = mvkMeshOutputTopology(pCreateInfo);
+	}
 

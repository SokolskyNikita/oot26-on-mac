+std::optional<u64> RunSimple(u32 ins, std::span<u64, 31> regs, u64& sp, u32& nzcv, u64 pc) {
+    const auto x = [&](u32 r) -> u64 { return r == 31 ? 0 : regs[r]; };
+    const auto sext = [](u64 v, int bits) { return static_cast<s64>(v << (64 - bits)) >> (64 - bits); };
+    if (ins == 0xD503201F) { // NOP
+        return pc + 4;
+    }
+    if ((ins & 0x1F000000) == 0x11000000) { // ADD/SUB (immediate), with or without flags
+        const bool sf = ins >> 31, sub = (ins >> 30) & 1, setf = (ins >> 29) & 1;
+        const u64 imm = static_cast<u64>((ins >> 10) & 0xFFF) << (((ins >> 22) & 1) ? 12 : 0);
+        const u32 rn = (ins >> 5) & 31, rd = ins & 31;

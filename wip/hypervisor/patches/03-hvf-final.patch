+struct HvfLive {
+    std::atomic<u32> burst{0}, loop{256};
+    std::atomic<bool> dirty_only{true}, raw_counter{false};
+    std::jthread watcher;
+    HvfLive() {
+        if (const char* v = std::getenv("EDEN_NX2_HVF_LOOP")) {
+            loop = static_cast<u32>(std::strtoul(v, nullptr, 10));
+        }
+        if (const char* v = std::getenv("EDEN_NX2_HVF_BURST")) {
+            burst = static_cast<u32>(std::strtoul(v, nullptr, 10));
+        }
+        if (const char* v = std::getenv("EDEN_NX2_HVF_DIRTY_ONLY")) {

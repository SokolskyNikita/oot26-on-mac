From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Nikita Sokolsky <sokolx@gmail.com>
Date: Thu, 19 Nov 2026 03:45:24 -0800
Subject: [PATCH] core: JIT invalidation entry points for the debug tools

The System-level calls the shared code cache depends on (core.cpp, core.h) and their debug-server command.

Co-Authored-By: Claude Fable 5.2 <noreply@anthropic.com>
---
 src/core/core.cpp                     | 20 ++++++++++++++++++++
 src/core/core.h                       |  5 +++++
 src/core/debugger/nx2_debug_tools.cpp |  6 ++++++
 3 files changed, 31 insertions(+)

diff --git a/src/core/core.cpp b/src/core/core.cpp
index 5c88fcc05e7..02e8f7ddbe3 100644
--- a/src/core/core.cpp
+++ b/src/core/core.cpp
@@ -94,6 +94,14 @@ std::atomic<u64> g_nx2_present_count{};
 static_assert(std::atomic<u64>::is_always_lock_free);
 std::array<std::atomic<u64>, 4096> g_nx2_present_times_ns{};
 
+std::atomic<u64> g_jit_flush_generation{};
+
+u64 RequestJitFlush(const char* why) {
+    const u64 generation = g_jit_flush_generation.fetch_add(1, std::memory_order_relaxed) + 1;
+    LOG_INFO(Core, "JIT code cache flush requested ({}), generation {}", why, generation);
+    return generation;
+}
+
 void RecordGuestPresent() {
     const u64 present = g_nx2_present_count.fetch_add(1, std::memory_order_relaxed) + 1;
     const u64 present_ns = std::chrono::duration_cast<std::chrono::nanoseconds>(
@@ -101,6 +109,18 @@ void RecordGuestPresent() {
                                .count();
     g_nx2_present_times_ns[present % g_nx2_present_times_ns.size()].store(
         present_ns, std::memory_order_relaxed);
+    // EDEN_NX2_JIT_FLUSH_ON_STALL=<ms>: a present after a gap that long ends a load or a stall.
+    static const u64 stall_ns = [] {
+        const char* value = std::getenv("EDEN_NX2_JIT_FLUSH_ON_STALL");
+        return value != nullptr ? std::strtoull(value, nullptr, 10) * 1'000'000ULL : 0ULL;
+    }();
+    static std::atomic<u64> last_ns{0}, last_flush_ns{0};
+    const u64 previous = last_ns.exchange(present_ns, std::memory_order_relaxed);
+    if (stall_ns != 0 && previous != 0 && present_ns - previous > stall_ns &&
+        present_ns - last_flush_ns.load(std::memory_order_relaxed) > 30'000'000'000ULL) {
+        last_flush_ns.store(present_ns, std::memory_order_relaxed);
+        RequestJitFlush("present stall");
+    }
 }
 
 FileSys::VirtualFile GetGameFileFromPath(const FileSys::VirtualFilesystem& vfs,
diff --git a/src/core/core.h b/src/core/core.h
index 0a879398996..b6f19cc09d0 100644
--- a/src/core/core.h
+++ b/src/core/core.h
@@ -124,6 +124,11 @@ extern std::atomic<u64> g_nx2_present_count;
 /// tool and bug reports.
 extern std::array<std::atomic<u64>, 4096> g_nx2_present_times_ns;
 void RecordGuestPresent();
+/// JIT code-cache flush requests: each CPU core flushes its JIT once when this generation moves on.
+/// EDEN_NX2_JIT_FLUSH_ON_STALL=<ms>: request one when the guest presents nothing for that long (a load), at most
+/// once every 30 s, so the cache drops load-time code then instead of filling up and flushing mid-play.
+extern std::atomic<u64> g_jit_flush_generation;
+u64 RequestJitFlush(const char* why);
 
 class CpuManager;
 class Debugger;
diff --git a/src/core/debugger/nx2_debug_tools.cpp b/src/core/debugger/nx2_debug_tools.cpp
index fc7287fe91d..a8daf650f5a 100644
--- a/src/core/debugger/nx2_debug_tools.cpp
+++ b/src/core/debugger/nx2_debug_tools.cpp
@@ -567,6 +567,11 @@ json SpeedLimit(ToolState&, const json& params) {
     return {{"previous", previous}, {"on", setting.GetValue()}};
 }
 
+json JitClear(ToolState&, const json&) {
+    // Every CPU core flushes its JIT code cache before it next runs guest code.
+    return {{"generation", Core::RequestJitFlush("debug server")}};
+}
+
 json HostTiming(ToolState& state, const json& params) {
     auto& stats = state.system.CoreTiming().host_wait_stats;
     const bool previous = stats.load();
@@ -775,6 +780,7 @@ Handlers MakeHandlers(const std::shared_ptr<ToolState>& state) {
         {"trace_stop", handler(TraceStop)},
         {"trace_status", handler(TraceStatus)},
         {"speed_limit", handler(SpeedLimit)},
+        {"jit_clear", handler(JitClear)},
         {"host_timing", handler(HostTiming)},
         {"read_memory", handler(ReadMemory)},
         {"search_memory", handler(SearchMemory)},

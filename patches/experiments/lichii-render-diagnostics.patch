 /// Creates the Vulkan pipeline for `render_pass`. A mesh pipeline without VK_EXT_mesh_shader is
 /// built from the mesh emulation's vertex shader as a point, line or triangle list.
+
+// Diagnostic: EDEN_NX2_DIAG_DEPTH_EQUAL=always|lequal|gequal|less|greater|notequal replaces the depth test of every
+// pipeline that asks for Equal (this build sets the compare op in the pipeline, not as dynamic state). Opaque colour
+// is drawn Equal against a depth pre-pass, so this shows whether a colour pass that leaves holes draws nothing there,
+// or draws nearer or farther than its pre-pass.
+static VkCompareOp DiagDepthEqual(VkCompareOp op) {
+    static const int diag_equal = [] {
+        const char* v = std::getenv("EDEN_NX2_DIAG_DEPTH_EQUAL");
+        if (!v) return -1;
+        const std::string_view s{v};
+        if (s == "always") return static_cast<int>(VK_COMPARE_OP_ALWAYS);
+        if (s == "lequal") return static_cast<int>(VK_COMPARE_OP_LESS_OR_EQUAL);
+        if (s == "gequal") return static_cast<int>(VK_COMPARE_OP_GREATER_OR_EQUAL);
+        if (s == "less") return static_cast<int>(VK_COMPARE_OP_LESS);
+        if (s == "greater") return static_cast<int>(VK_COMPARE_OP_GREATER);
+        if (s == "notequal") return static_cast<int>(VK_COMPARE_OP_NOT_EQUAL);
+        return -1;
+    }();
+    if (diag_equal >= 0 && op == VK_COMPARE_OP_EQUAL) {
+        static std::atomic<int> count{};
+        if (++count <= 3) std::fprintf(stderr, "[diag-depth] Equal replaced in a pipeline\n");
+        return static_cast<VkCompareOp>(diag_equal);
+    }
+    return op;
+}

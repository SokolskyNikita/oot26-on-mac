+// EDEN_NX2_HVF_LOOP=N: besides loads and stores, run these here too, so a memset/memcpy loop into
+// GPU-cached memory costs one exit instead of one per store: NOP, ADD/SUB(S) immediate (CMP/CMN),
+// B, B.cond, CBZ/CBNZ, TBZ/TBNZ. Returns the next pc, or nothing for any other instruction.
+bool ConditionHolds(u32 cond, u32 nzcv) {
+    const bool n = nzcv & 8, z = nzcv & 4, c = nzcv & 2, v = nzcv & 1;
+    bool r;
+    switch (cond >> 1) {
+    case 0: r = z; break;
+    case 1: r = c; break;
+    case 2: r = n; break;
+    case 3: r = v; break;
+    case 4: r = c && !z; break;
+    case 5: r = n == v; break;
+    case 6: r = !z && n == v; break;
+    default: r = true; break;
+    }
+    return (cond & 1) && cond != 15 ? !r : r;
+}
+std::optional<u64> RunSimple(u32 ins, std::span<u64, 31> regs, u64& sp, u32& nzcv, u64 pc) {
+    const auto x = [&](u32 r) -> u64 { return r == 31 ? 0 : regs[r]; };
+    const auto sext = [](u64 v, int bits) { return static_cast<s64>(v << (64 - bits)) >> (64 - bits); };
+    if (ins == 0xD503201F) { // NOP
+        return pc + 4;
+    }
+    if ((ins & 0x1F000000) == 0x11000000) { // ADD/SUB (immediate), with or without flags
+        const bool sf = ins >> 31, sub = (ins >> 30) & 1, setf = (ins >> 29) & 1;
+        const u64 imm = static_cast<u64>((ins >> 10) & 0xFFF) << (((ins >> 22) & 1) ? 12 : 0);
+        const u32 rn = (ins >> 5) & 31, rd = ins & 31;
+        if ((ins >> 23) & 1) {
+            return std::nullopt; // tag variants and unallocated
+        }
+        const u64 a = rn == 31 ? sp : regs[rn];
+        const u64 mask = sf ? ~u64{0} : 0xFFFFFFFFULL;
+        const u64 b = sub ? (~imm & mask) : imm;
+        const u64 carry_in = sub ? 1 : 0;
+        const u64 am = a & mask;
+        const unsigned __int128 wide = static_cast<unsigned __int128>(am) + b + carry_in;
+        const u64 result = static_cast<u64>(wide) & mask;
+        if (setf) {
+            const int bits = sf ? 64 : 32;
+            const bool n = (result >> (bits - 1)) & 1, z = result == 0;
+            const bool c = sf ? (wide >> 64) != 0 : ((wide >> 32) & 1) != 0;
+            const bool sa = (am >> (bits - 1)) & 1, sb = (b >> (bits - 1)) & 1;
+            const bool v = sa == sb && sa != n;

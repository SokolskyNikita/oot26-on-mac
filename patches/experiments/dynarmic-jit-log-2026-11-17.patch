+struct JitLog {
+    std::FILE* file = nullptr;
+    std::mutex mutex;
+    u64 last_flush_ns = 0;
+    JitLog() {
+        if (const char* path = std::getenv("EDEN_NX2_JIT_LOG"); path != nullptr && path[0] != '\0') {
+            file = std::fopen(path, "wb");
+            if (file) {

+    const u32 invocations = program.workgroup_size[0] * program.workgroup_size[1] *
+                            program.workgroup_size[2];
+    if (!has_hmma || invocations % GUEST_WARP_LANES != 0) {
+        return std::nullopt;
+    }
+    return invocations / GUEST_WARP_LANES;

+        const bool sf = ins >> 31, nz = (ins >> 24) & 1;
+        const u64 v = x(ins & 31) & (sf ? ~u64{0} : 0xFFFFFFFFULL);
+        return (v == 0) != nz ? pc + (sext((ins >> 5) & 0x7FFFF, 19) << 2) : pc + 4;
+    }
+    if ((ins & 0x7E000000) == 0x36000000) { // TBZ/TBNZ
+        const u32 bit = ((ins >> 31) << 5) | ((ins >> 19) & 31);
+        const bool nz = (ins >> 24) & 1;
+        const bool set = (x(ins & 31) >> bit) & 1;
+        return set == nz ? pc + (sext((ins >> 5) & 0x3FFF, 14) << 2) : pc + 4;
+    }
+    return std::nullopt;
+}

+// Live switches. EDEN_NX2_HVF_CTL=<file>: a watcher re-reads "BURST=n DIRTY=0|1 RAW=0|1" from it every
+// 100 ms, so one boot can measure several settings.
+struct HvfLive {
+    std::atomic<u32> burst{0}, loop{0};
+    std::atomic<bool> dirty_only{false}, raw_counter{false};
+    std::jthread watcher;
+    HvfLive() {
+        if (const char* v = std::getenv("EDEN_NX2_HVF_LOOP")) {
+            loop = static_cast<u32>(std::strtoul(v, nullptr, 10));
+        }
+        if (const char* v = std::getenv("EDEN_NX2_HVF_BURST")) {
+            burst = static_cast<u32>(std::strtoul(v, nullptr, 10));
+        }
+        dirty_only = HvfFlag("EDEN_NX2_HVF_DIRTY_ONLY");
+        raw_counter = HvfFlag("EDEN_NX2_HVF_RAW_COUNTER");
+        if (const char* path = std::getenv("EDEN_NX2_HVF_CTL")) {
+            watcher = std::jthread([this, file = std::string(path)](std::stop_token stop) {
+                std::string last;
+                while (!stop.stop_requested()) {
+                    std::string text;
+                    if (std::FILE* f = std::fopen(file.c_str(), "r")) {
+                        char buf[256]{};
+                        text.assign(buf, std::fread(buf, 1, sizeof(buf) - 1, f));
+                        std::fclose(f);
+                    }
+                    if (!text.empty() && text != last) {
+                        last = text;
+                        const auto field = [&](const char* key) -> long {
+                            const size_t at = text.find(key);
+                            return at == std::string::npos ? -1 : std::strtol(text.c_str() + at + std::strlen(key), nullptr, 10);
+                        };
+                        if (const long b = field("BURST="); b >= 0) burst = static_cast<u32>(b);
+                        if (const long l = field("LOOP="); l >= 0) loop = static_cast<u32>(l);
+                        if (const long d = field("DIRTY="); d >= 0) dirty_only = d != 0;
+                        if (const long r = field("RAW="); r >= 0) raw_counter = r != 0;
+                        LOG_INFO(Core_ARM, "Hypervisor live switches: burst {} loop {} dirty_only {} raw_counter {}",
+                                 burst.load(), loop.load(), dirty_only.load(), raw_counter.load());

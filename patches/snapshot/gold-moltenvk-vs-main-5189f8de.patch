diff --git a/MoltenVK/MoltenVK/Utility/MVKFrameProf.h b/MoltenVK/MoltenVK/Utility/MVKFrameProf.h
new file mode 100644
index 00000000..dbce351f
--- /dev/null
+++ b/MoltenVK/MoltenVK/Utility/MVKFrameProf.h
@@ -0,0 +1,36 @@
+/*
+ * MVKFrameProf.h: per-pass GPU timing for the frame-profile investigation (not upstream).
+ *
+ * Off unless MVK_FRAMEPROF=<output file> is set. When on, every Metal render, compute and blit encoder that
+ * MVKCommandEncoder creates gets stage-boundary timestamps from an MTLCounterSampleBuffer (render: vertex start/end,
+ * fragment start/end; compute and blit: start/end). When a MTLCommandBuffer completes, its encoders are summed by
+ * signature (kind, command use, restart, target size, formats, load action) and one block per command buffer is
+ * written to the file. Presents are counted to tag each command buffer with a frame number.
+ */
+#pragma once
+
+#import <Metal/Metal.h>
+#include <cstdint>
+#include <cstddef>
+
+namespace mvkfp {
+
+bool enabled();
+
+/** Call once per vkQueuePresentKHR (frame boundary). */
+void onPresent();
+
+/** Adds sample attachments to the render pass descriptor. Returns a counter to bump once per draw, or null. */
+uint32_t* attachRender(id<MTLCommandBuffer> cb, MTLRenderPassDescriptor* rpd, uint32_t cmdUse, bool isRestart);
+
+/** Returns a compute pass descriptor with sample attachments (or nil when off or out of samples). */
+MTLComputePassDescriptor* computeDesc(id<MTLCommandBuffer> cb, MTLDispatchType type, uint32_t cmdUse, uint32_t** work);
+
+/** Tags the current compute encoder (its work counter) with the dispatch's shader hash and threadgroup count
+ *  (0 = indirect). The first dispatch's shader names the encoder. */
+void noteDispatch(uint32_t* work, size_t hash, uint64_t groups, uint64_t tgThreads);
+
+/** Returns a blit pass descriptor with sample attachments (or nil). */
+MTLBlitPassDescriptor* blitDesc(id<MTLCommandBuffer> cb, uint32_t cmdUse, uint32_t** work);
+
+}
diff --git a/MoltenVK/MoltenVK/Utility/MVKFrameProf.mm b/MoltenVK/MoltenVK/Utility/MVKFrameProf.mm
new file mode 100644
index 00000000..bc172484
--- /dev/null
+++ b/MoltenVK/MoltenVK/Utility/MVKFrameProf.mm
@@ -0,0 +1,336 @@
+/*
+ * MVKFrameProf.mm: see MVKFrameProf.h. Manual retain/release (MoltenVK is not built with ARC).
+ *
+ * Output (text, one record per line):
+ *   T <cpu_ns> <gpu_ticks>                      calibration pairs from -[MTLDevice sampleTimestamps:gpuTimestamp:]
+ *   P <frame> <host_us>                         a present (frame = presents before it)
+ *   C <frame> <gpu_start_us> <gpu_end_us> <encoders> <unsampled> <kernel_start_us> <kernel_end_us> <first_encoder_host_us>
+ *   S <sig> <count> <span> <vertex> <fragment> <work> <groups> <indirect>  its encoders summed by signature, GPU ticks
+ *   E <i> <sig> <t0> <t1> <vertex> <fragment> <work>               every encoder, only for frames % 150 == 0;
+ *                                                                  t0/t1 in GPU ticks from the buffer's first sample
+ * Signatures: R|C|B : use : r(estart)0/1 : WxH : colour attachment count : colour 0 format : depth format :
+ * colour 0 load action. Times of a render encoder: span = last end - first start; vertex = vertex end - start;
+ * fragment = fragment end - start. A sample Metal could not take reads as 0 and is left out.
+ */
+
+#include "MVKFrameProf.h"
+#include <mach/mach_time.h>
+#include <atomic>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <map>
+#include <mutex>
+#include <string>
+#include <vector>
+
+namespace mvkfp {
+
+static constexpr uint32_t kMaxEnc = 2048;
+
+struct Enc {
+	char kind;
+	bool restart;
+	uint16_t use;
+	uint16_t ncolor, fmt0, dfmt, load0;
+	uint32_t w, h;
+	uint32_t base, nsamp;
+	uint32_t work;
+	uint64_t hash;
+	uint64_t groups;
+	uint32_t tgThreads;
+	uint32_t indirect;
+};
+
+struct Rec {
+	uint64_t frame;
+	double created;
+	id<MTLCounterSampleBuffer> sb;
+	uint32_t used;
+	uint32_t nenc;
+	uint32_t unsampled;
+	Enc enc[kMaxEnc];
+};
+
+static std::once_flag s_once;
+static bool s_on = false;
+static FILE* s_out = nullptr;
+static std::mutex s_lock;                       // s_map, s_pool, s_out
+static std::map<void*, Rec*> s_map;              // MTLCommandBuffer -> its record, until it completes
+static std::vector<Rec*> s_pool;
+static id<MTLCounterSet> s_tsSet = nil;
+static uint32_t s_samples = 0;                   // per sample buffer
+static std::atomic<uint64_t> s_frame{0};
+static uint64_t s_lastFlush = 0;
+static mach_timebase_info_data_t s_tb;
+
+static double hostUs(uint64_t abs) { return (double)abs * s_tb.numer / s_tb.denom / 1000.0; }
+
+static void init() {
+	const char* path = getenv("MVK_FRAMEPROF");
+	if (!path || !*path) { return; }
+	s_out = fopen(path, "w");
+	if (!s_out) { return; }
+	setvbuf(s_out, nullptr, _IOFBF, 1 << 20);
+	mach_timebase_info(&s_tb);
+	s_on = true;
+}
+
+bool enabled() {
+	std::call_once(s_once, init);
+	return s_on;
+}
+
+void onPresent() {
+	if (!enabled()) { return; }
+	uint64_t f = s_frame.fetch_add(1);
+	std::lock_guard<std::mutex> g(s_lock);
+	fprintf(s_out, "P %llu %.1f\n", (unsigned long long)f, hostUs(mach_absolute_time()));
+}
+
+static void calibrate(id<MTLDevice> dev) {
+	MTLTimestamp c = 0, gt = 0;
+	[dev sampleTimestamps: &c gpuTimestamp: &gt];
+	fprintf(s_out, "T %llu %llu\n", (unsigned long long)c, (unsigned long long)gt);
+}
+
+// Caller holds s_lock.
+static bool setupDevice(id<MTLDevice> dev) {
+	if (s_samples) { return true; }
+	if (!s_tsSet) {
+		for (id<MTLCounterSet> cs in dev.counterSets) {
+			if ([cs.name caseInsensitiveCompare: MTLCommonCounterSetTimestamp] == NSOrderedSame) { s_tsSet = [cs retain]; }
+		}
+		if (!s_tsSet) { fprintf(s_out, "# no timestamp counter set\n"); s_on = false; return false; }
+		fprintf(s_out, "# stage boundary sampling: %d\n",
+				(int)[dev supportsCounterSampling: MTLCounterSamplingPointAtStageBoundary]);
+	}
+	for (uint32_t n = 16384; n >= 256; n /= 2) {
+		MTLCounterSampleBufferDescriptor* d = [[MTLCounterSampleBufferDescriptor alloc] init];
+		d.counterSet = s_tsSet;
+		d.storageMode = MTLStorageModeShared;
+		d.sampleCount = n;
+		NSError* err = nil;
+		id<MTLCounterSampleBuffer> sb = [dev newCounterSampleBufferWithDescriptor: d error: &err];
+		[d release];
+		if (sb) {
+			[sb release];
+			s_samples = n;
+			fprintf(s_out, "# sample buffer size %u\n", n);
+			calibrate(dev);
+			return true;
+		}
+	}
+	fprintf(s_out, "# could not make a counter sample buffer\n");
+	s_on = false;
+	return false;
+}
+
+static void finish(Rec* r, id<MTLCommandBuffer> mcb);
+
+// Caller holds s_lock.
+static Rec* recFor(id<MTLCommandBuffer> cb) {
+	auto it = s_map.find((void*)cb);
+	if (it != s_map.end()) { return it->second; }
+	if (!setupDevice(cb.device)) { return nullptr; }
+	Rec* r;
+	if (!s_pool.empty()) {
+		r = s_pool.back();
+		s_pool.pop_back();
+	} else {
+		r = new Rec();
+		MTLCounterSampleBufferDescriptor* d = [[MTLCounterSampleBufferDescriptor alloc] init];
+		d.counterSet = s_tsSet;
+		d.storageMode = MTLStorageModeShared;
+		d.sampleCount = s_samples;
+		NSError* err = nil;
+		r->sb = [cb.device newCounterSampleBufferWithDescriptor: d error: &err];
+		[d release];
+		if (!r->sb) { delete r; return nullptr; }
+	}
+	r->frame = s_frame.load();
+	r->created = hostUs(mach_absolute_time());
+	r->used = 0;
+	r->nenc = 0;
+	r->unsampled = 0;
+	s_map[(void*)cb] = r;
+	[cb addCompletedHandler: ^(id<MTLCommandBuffer> mcb) {
+		{
+			std::lock_guard<std::mutex> g(s_lock);
+			s_map.erase((void*)mcb);
+		}
+		finish(r, mcb);
+	}];
+	return r;
+}
+
+// Caller holds s_lock.
+static Enc* newEnc(id<MTLCommandBuffer> cb, char kind, uint32_t nsamp, uint32_t cmdUse) {
+	Rec* r = recFor(cb);
+	if (!r) { return nullptr; }
+	if (r->nenc >= kMaxEnc || r->used + nsamp > s_samples) { r->unsampled++; return nullptr; }
+	Enc& e = r->enc[r->nenc++];
+	memset(&e, 0, sizeof(e));
+	e.kind = kind;
+	e.use = (uint16_t)cmdUse;
+	e.base = r->used;
+	e.nsamp = nsamp;
+	r->used += nsamp;
+	return &e;
+}
+
+uint32_t* attachRender(id<MTLCommandBuffer> cb, MTLRenderPassDescriptor* rpd, uint32_t cmdUse, bool isRestart) {
+	if (!enabled() || !cb) { return nullptr; }
+	std::lock_guard<std::mutex> g(s_lock);
+	if (!s_on) { return nullptr; }
+	Rec* r = recFor(cb);
+	Enc* e = newEnc(cb, 'R', 4, cmdUse);
+	if (!e) { return nullptr; }
+	e->restart = isRestart;
+	e->w = (uint32_t)rpd.renderTargetWidth;
+	e->h = (uint32_t)rpd.renderTargetHeight;
+	for (uint32_t i = 0; i < 8; i++) {
+		id<MTLTexture> t = rpd.colorAttachments[i].texture;
+		if (!t) { continue; }
+		if (e->ncolor == 0) {
+			e->fmt0 = (uint16_t)t.pixelFormat;
+			e->load0 = (uint16_t)rpd.colorAttachments[i].loadAction;
+			if (!e->w) { e->w = (uint32_t)t.width; e->h = (uint32_t)t.height; }
+		}
+		e->ncolor++;
+	}
+	id<MTLTexture> dt = rpd.depthAttachment.texture;
+	if (!dt) { dt = rpd.stencilAttachment.texture; }
+	if (dt) {
+		e->dfmt = (uint16_t)dt.pixelFormat;
+		if (e->ncolor == 0) { e->load0 = (uint16_t)rpd.depthAttachment.loadAction; }
+		if (!e->w) { e->w = (uint32_t)dt.width; e->h = (uint32_t)dt.height; }
+	}
+	MTLRenderPassSampleBufferAttachmentDescriptor* a = rpd.sampleBufferAttachments[0];
+	a.sampleBuffer = r->sb;
+	a.startOfVertexSampleIndex = e->base;
+	a.endOfVertexSampleIndex = e->base + 1;
+	a.startOfFragmentSampleIndex = e->base + 2;
+	a.endOfFragmentSampleIndex = e->base + 3;
+	return &e->work;
+}
+
+MTLComputePassDescriptor* computeDesc(id<MTLCommandBuffer> cb, MTLDispatchType type, uint32_t cmdUse, uint32_t** work) {
+	*work = nullptr;
+	if (!enabled() || !cb) { return nil; }
+	std::lock_guard<std::mutex> g(s_lock);
+	if (!s_on) { return nil; }
+	Rec* r = recFor(cb);
+	Enc* e = newEnc(cb, 'C', 2, cmdUse);
+	if (!e) { return nil; }
+	MTLComputePassDescriptor* d = [MTLComputePassDescriptor computePassDescriptor];
+	d.dispatchType = type;
+	d.sampleBufferAttachments[0].sampleBuffer = r->sb;
+	d.sampleBufferAttachments[0].startOfEncoderSampleIndex = e->base;
+	d.sampleBufferAttachments[0].endOfEncoderSampleIndex = e->base + 1;
+	*work = &e->work;
+	return d;
+}
+
+MTLBlitPassDescriptor* blitDesc(id<MTLCommandBuffer> cb, uint32_t cmdUse, uint32_t** work) {
+	*work = nullptr;
+	if (!enabled() || !cb) { return nil; }
+	std::lock_guard<std::mutex> g(s_lock);
+	if (!s_on) { return nil; }
+	Rec* r = recFor(cb);
+	Enc* e = newEnc(cb, 'B', 2, cmdUse);
+	if (!e) { return nil; }
+	MTLBlitPassDescriptor* d = [MTLBlitPassDescriptor blitPassDescriptor];
+	d.sampleBufferAttachments[0].sampleBuffer = r->sb;
+	d.sampleBufferAttachments[0].startOfEncoderSampleIndex = e->base;
+	d.sampleBufferAttachments[0].endOfEncoderSampleIndex = e->base + 1;
+	*work = &e->work;
+	return d;
+}
+
+void noteDispatch(uint32_t* work, size_t hash, uint64_t groups, uint64_t tgThreads) {
+	if (!work) { return; }
+	Enc* e = (Enc*)((char*)work - offsetof(Enc, work));
+	if (!e->hash) { e->hash = hash; e->tgThreads = (uint32_t)tgThreads; }
+	if (groups) { e->groups += groups; } else { e->indirect++; }
+}
+
+static void sigOf(const Enc& e, char* buf, size_t n) {
+	if (e.kind == 'R') {
+		snprintf(buf, n, "R:%u:%d:%ux%u:%u:%u:%u:%u", e.use, (int)e.restart, e.w, e.h, e.ncolor, e.fmt0, e.dfmt, e.load0);
+	} else if (e.kind == 'C') {
+		snprintf(buf, n, "C:%u:%016zx:%u", e.use, (size_t)e.hash, e.tgThreads);
+	} else {
+		snprintf(buf, n, "%c:%u", e.kind, e.use);
+	}
+}
+
+static inline bool ok(uint64_t v) { return v != 0 && v != MTLCounterErrorValue; }
+
+static void finish(Rec* r, id<MTLCommandBuffer> mcb) {
+	double gpuStart = mcb.GPUStartTime, gpuEnd = mcb.GPUEndTime;
+	double kStart = mcb.kernelStartTime, kEnd = mcb.kernelEndTime;
+	const uint64_t* ts = nullptr;
+	NSData* data = nil;
+	if (r->used) {
+		data = [r->sb resolveCounterRange: NSMakeRange(0, r->used)];
+		if (data) { ts = (const uint64_t*)data.bytes; }
+	}
+	struct Agg { uint32_t count = 0; uint64_t span = 0, vtx = 0, frag = 0, work = 0, groups = 0, indirect = 0; };
+	std::map<std::string, Agg> agg;
+	uint64_t first = UINT64_MAX;
+	if (ts) {
+		for (uint32_t i = 0; i < r->used; i++) { if (ok(ts[i]) && ts[i] < first) { first = ts[i]; } }
+	}
+	std::string detail;
+	bool dump = (r->frame % 150) == 0;
+	char sig[96], line[256];
+	for (uint32_t i = 0; i < r->nenc; i++) {
+		const Enc& e = r->enc[i];
+		sigOf(e, sig, sizeof(sig));
+		Agg& a = agg[sig];
+		a.count++;
+		a.work += e.work;
+		a.groups += e.groups;
+		a.indirect += e.indirect;
+		uint64_t lo = UINT64_MAX, hi = 0, v = 0, f = 0;
+		if (ts) {
+			for (uint32_t k = 0; k < e.nsamp; k++) {
+				uint64_t t = ts[e.base + k];
+				if (!ok(t)) { continue; }
+				if (t < lo) { lo = t; }
+				if (t > hi) { hi = t; }
+			}
+			if (e.kind == 'R') {
+				const uint64_t* s = ts + e.base;
+				if (ok(s[0]) && ok(s[1]) && s[1] >= s[0]) { v = s[1] - s[0]; }
+				if (ok(s[2]) && ok(s[3]) && s[3] >= s[2]) { f = s[3] - s[2]; }
+			}
+		}
+		uint64_t span = (hi >= lo && lo != UINT64_MAX) ? hi - lo : 0;
+		a.span += span; a.vtx += v; a.frag += f;
+		if (dump) {
+			snprintf(line, sizeof(line), "E %u %s %llu %llu %llu %llu %u\n", i, sig,
+					 (unsigned long long)(lo != UINT64_MAX && first != UINT64_MAX ? lo - first : 0),
+					 (unsigned long long)(hi && first != UINT64_MAX ? hi - first : 0),
+					 (unsigned long long)v, (unsigned long long)f, e.work);
+			detail += line;
+		}
+	}
+	std::lock_guard<std::mutex> g(s_lock);
+	fprintf(s_out, "C %llu %.1f %.1f %u %u %.1f %.1f %.1f\n", (unsigned long long)r->frame, gpuStart * 1e6, gpuEnd * 1e6,
+			r->nenc, r->unsampled, kStart * 1e6, kEnd * 1e6, r->created);
+	for (auto& kv : agg) {
+		fprintf(s_out, "S %s %u %llu %llu %llu %llu %llu %llu\n", kv.first.c_str(), kv.second.count,
+				(unsigned long long)kv.second.span, (unsigned long long)kv.second.vtx,
+				(unsigned long long)kv.second.frag, (unsigned long long)kv.second.work,
+				(unsigned long long)kv.second.groups, (unsigned long long)kv.second.indirect);
+	}
+	if (dump) { fputs(detail.c_str(), s_out); }
+	if (r->frame == 600 || r->frame == 3000) { calibrate(r->sb.device); }
+	uint64_t now = mach_absolute_time();
+	if (hostUs(now - s_lastFlush) > 1e6) { fflush(s_out); s_lastFlush = now; }
+	s_pool.push_back(r);
+}
+
+}
diff --git a/MoltenVK/MoltenVK/Utility/MVKSlimTextureClasses.cpp b/MoltenVK/MoltenVK/Utility/MVKSlimTextureClasses.cpp
new file mode 100644
index 00000000..e3929cbf
--- /dev/null
+++ b/MoltenVK/MoltenVK/Utility/MVKSlimTextureClasses.cpp
@@ -0,0 +1,375 @@
+/*
+ * MVKSlimTextureClasses.cpp
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *     http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+#include "MVKSlimTextureClasses.h"
+
+#include <cctype>
+#include <cstring>
+#include <fstream>
+#include <map>
+#include <mutex>
+#include <set>
+#include <sstream>
+#include <vector>
+#include <glob.h>
+#include <TargetConditionals.h>
+
+namespace {
+
+// The classes covered: sampled float colour textures, and the depth classes SPIRV-Cross reaches
+// through spvDepthCast().
+struct Kind { const char* name; const char* depthOf; };
+const Kind kKinds[] = {
+	{ "texture2d", nullptr }, { "texture3d", nullptr }, { "texture2d_array", nullptr }, { "texturecube", nullptr },
+	{ "depth2d", "texture2d" }, { "depth2d_array", "texture2d_array" }, { "depthcube", "texturecube" },
+};
+
+struct Method {
+	std::string name;	// the member function's name
+	std::string text;	// its declaration and body, as in the header
+};
+
+struct KindInfo {
+	std::string handleType;			// the builtin handle member's type, such as __metal_texture_2d_t
+	std::vector<Method> methods;	// const thread and const constant member functions
+};
+
+struct Library {
+	bool usable = false;
+	std::map<std::string, KindInfo> kinds;
+};
+
+bool isIdent(char c) { return isalnum((unsigned char)c) || c == '_'; }
+
+std::string readFile(const std::string& path) {
+	std::ifstream f(path, std::ios::binary);
+	if ( !f ) { return {}; }
+	std::ostringstream s;
+	s << f.rdbuf();
+	return s.str();
+}
+
+std::vector<std::string> splitLines(const std::string& text) {
+	std::vector<std::string> lines;
+	size_t pos = 0;
+	while (pos <= text.size()) {
+		size_t nl = text.find('\n', pos);
+		if (nl == std::string::npos) { nl = text.size(); }
+		lines.emplace_back(text, pos, nl - pos);
+		pos = nl + 1;
+	}
+	return lines;
+}
+
+std::string trimmed(const std::string& s) {
+	size_t b = s.find_first_not_of(" \t");
+	if (b == std::string::npos) { return {}; }
+	size_t e = s.find_last_not_of(" \t\r");
+	return s.substr(b, e - b + 1);
+}
+
+// Evaluates the conditions these headers use: defined(X), !defined(X), X == N, joined by && or ||.
+// Anything else makes the whole library unusable.
+struct Preprocessor {
+	std::map<std::string, long> macros;
+	bool failed = false;
+
+	bool term(const std::string& e, size_t& i) {
+		while (i < e.size() && e[i] == ' ') { i++; }
+		bool neg = false;
+		if (i < e.size() && e[i] == '!') { neg = true; i++; }
+		size_t s = i;
+		while (i < e.size() && isIdent(e[i])) { i++; }
+		std::string id = e.substr(s, i - s);
+		bool val;
+		if (id == "defined") {
+			while (i < e.size() && (e[i] == ' ' || e[i] == '(')) { i++; }
+			s = i;
+			while (i < e.size() && isIdent(e[i])) { i++; }
+			val = macros.count(e.substr(s, i - s)) > 0;
+			while (i < e.size() && (e[i] == ' ' || e[i] == ')')) { i++; }
+		} else {
+			while (i < e.size() && e[i] == ' ') { i++; }
+			if (id.empty() || e.compare(i, 2, "==") != 0) { failed = true; return false; }
+			i += 2;
+			char* end = nullptr;
+			long n = strtol(e.c_str() + i, &end, 10);
+			if (end == e.c_str() + i) { failed = true; return false; }
+			i = end - e.c_str();
+			auto m = macros.find(id);
+			val = m != macros.end() && m->second == n;
+		}
+		return neg ? !val : val;
+	}
+
+	bool evaluate(const std::string& e) {
+		size_t i = 0;
+		bool val = term(e, i);
+		while ( !failed ) {
+			while (i < e.size() && e[i] == ' ') { i++; }
+			if (i >= e.size() || e.compare(i, 2, "//") == 0) { break; }
+			bool isAnd = e.compare(i, 2, "&&") == 0;
+			if ( !isAnd && e.compare(i, 2, "||") != 0 ) { failed = true; break; }
+			i += 2;
+			bool rhs = term(e, i);
+			val = isAnd ? (val && rhs) : (val || rhs);
+		}
+		return val;
+	}
+
+	// Returns the lines that survive the conditionals. Records #define lines when defining is set.
+	std::vector<std::string> run(const std::string& text, bool defining) {
+		std::vector<std::string> out;
+		std::vector<int> stack;		// per open conditional: 0 = skipping, 1 = active, 2 = an outer one is off
+		bool active = true;
+		for (auto& line : splitLines(text)) {
+			std::string t = trimmed(line);
+			if (t.empty() || t[0] != '#') { if (active) { out.push_back(line); } continue; }
+			size_t i = 1;
+			while (i < t.size() && t[i] == ' ') { i++; }
+			size_t s = i;
+			while (i < t.size() && isalpha((unsigned char)t[i])) { i++; }
+			std::string dir = t.substr(s, i - s), rest = trimmed(t.substr(i));
+			if (dir == "if" || dir == "ifdef" || dir == "ifndef") {
+				if ( !active ) { stack.push_back(2); continue; }
+				bool v;
+				if (dir == "if") { v = evaluate(rest); }
+				else {
+					size_t e = 0;
+					while (e < rest.size() && isIdent(rest[e])) { e++; }
+					v = macros.count(rest.substr(0, e)) > 0;
+					if (dir == "ifndef") { v = !v; }
+				}
+				stack.push_back(v ? 1 : 0);
+				active = v;
+			} else if (dir == "else") {
+				if (stack.empty()) { failed = true; break; }
+				if (stack.back() != 2) { stack.back() = stack.back() ? 0 : 1; active = stack.back() == 1; }
+			} else if (dir == "elif") {
+				failed = true; break;
+			} else if (dir == "endif") {
+				if (stack.empty()) { failed = true; break; }
+				stack.pop_back();
+				active = true;
+				for (int st : stack) { if (st != 1) { active = false; } }
+			} else if (dir == "define" && active && defining) {
+				size_t e = 0;
+				while (e < rest.size() && isIdent(rest[e])) { e++; }
+				std::string val = trimmed(rest.substr(e));
+				macros[rest.substr(0, e)] = val.empty() ? 1 : strtol(val.c_str(), nullptr, 10);
+			}
+			// #include, #pragma and anything else are dropped: only class bodies are wanted.
+		}
+		if ( !stack.empty() ) { failed = true; }
+		return out;
+	}
+};
+
+std::string headerDirectory() {
+	// The compiler that MTLCompilerService runs is the framework's current version.
+	glob_t g;
+	std::string dir;
+	if (glob("/System/Library/PrivateFrameworks/GPUCompiler.framework/Versions/Current/Libraries/lib/clang/*/include/metal",
+			 0, nullptr, &g) == 0 && g.gl_pathc > 0) {
+		dir = g.gl_pathv[0];
+	}
+	globfree(&g);
+	return dir;
+}
+
+bool startsWith(const std::string& s, const char* prefix) { return s.compare(0, strlen(prefix), prefix) == 0; }
+
+bool loadKind(const std::string& dir, Preprocessor& pp, const char* kind, KindInfo& info) {
+	std::string text = readFile(dir + "/__bits/metal_" + kind);
+	if (text.empty()) { return false; }
+	// The header's include guard must not look defined, and its #defines must not leak.
+	auto lines = pp.run(text, false);
+	if (pp.failed) { return false; }
+
+	std::string classStart = std::string("struct ") + kind + " :";
+	std::string specStart = std::string("struct ") + kind + "<";
+	size_t end = lines.size();
+	for (size_t i = 0; i < lines.size(); i++) {
+		if (startsWith(lines[i], classStart.c_str()) || startsWith(lines[i], specStart.c_str())) { end = i; break; }
+	}
+	if (end == lines.size()) { return false; }
+
+	for (size_t i = end; i < lines.size(); i++) {
+		std::string t = trimmed(lines[i]);
+		if (startsWith(t, "__metal_") && t.size() > 5 && t.compare(t.size() - 5, 5, "_t t;") == 0) {
+			info.handleType = t.substr(0, t.size() - 3);
+			break;
+		}
+	}
+	if (info.handleType.empty()) { return false; }
+
+	for (size_t i = 0; i < end; i++) {
+		const std::string& l = lines[i];
+		if ( !startsWith(l, "  METAL_FUNC ") ) { continue; }
+		std::string decl = trimmed(l);
+		if (decl.back() == ';') { continue; }
+		size_t j = i + 1;
+		while (j < end && lines[j] != "  }") { j++; }
+		if (j >= end) { return false; }
+
+		// The qualifiers follow the parameter list, before any METAL_..._ARG(...) annotations.
+		const std::string& head = decl;
+		size_t open = head.find('(');
+		if (open == std::string::npos) { i = j; continue; }
+		size_t close = open;
+		for (int depth = 0; close < head.size(); close++) {
+			if (head[close] == '(') { depth++; }
+			else if (head[close] == ')' && --depth == 0) { break; }
+		}
+		if (close >= head.size()) { i = j; continue; }
+		std::string qual = head.substr(close + 1);
+		size_t annotation = qual.find(" METAL_");
+		if (annotation != std::string::npos) { qual.erase(annotation); }
+		qual = trimmed(qual);
+		if (qual == "const thread" || qual == "const constant") {
+			size_t ne = open, ns = open;
+			while (ns > 0 && isIdent(head[ns - 1])) { ns--; }
+			Method m;
+			m.name = head.substr(ns, ne - ns);
+			if (i > 0 && startsWith(lines[i - 1], "  template")) { m.text = lines[i - 1] + "\n"; }
+			for (size_t k = i; k <= j; k++) { m.text += lines[k]; m.text += '\n'; }
+			// sampler's handle is private, and readable only by the standard library's own classes.
+			for (size_t p = 0; (p = m.text.find("s.val", p)) != std::string::npos; ) {
+				bool word = (p == 0 || !isIdent(m.text[p - 1])) && (p + 5 >= m.text.size() || !isIdent(m.text[p + 5]));
+				if (word) { m.text.replace(p, 5, "_mvkSamplerHandle::val(s)"); p += 25; } else { p += 5; }
+			}
+			if ( !m.name.empty() ) { info.methods.push_back(std::move(m)); }
+		}
+		i = j;
+	}
+	return !info.methods.empty();
+}
+
+const Library& library(uint32_t mslVersion) {
+	static std::mutex lock;
+	static std::map<uint32_t, Library> libraries;
+	std::lock_guard<std::mutex> guard(lock);
+	auto found = libraries.find(mslVersion);
+	if (found != libraries.end()) { return found->second; }
+
+	Library& lib = libraries[mslVersion];
+	std::string dir = headerDirectory();
+	std::string config = dir.empty() ? std::string() : readFile(dir + "/metal_config");
+	if (config.empty()) { return lib; }
+
+	Preprocessor pp;
+	pp.macros["__METAL_VERSION__"] = mslVersion;
+#if defined(TARGET_OS_OSX) && !TARGET_OS_OSX
+	pp.macros["__METAL_IOS__"] = 1;
+#else
+	pp.macros["__METAL_MACOS__"] = 1;
+#endif
+	pp.run(config, true);
+	// The explicit specializations name the memory coherence parameter the classes have from MSL 3.2.
+	if (pp.failed || !pp.macros.count("__HAVE_DEVICE_COHERENT_READ_WRITE_TEXTURES__")) { return lib; }
+
+	for (auto& k : kKinds) {
+		KindInfo info;
+		if (loadKind(dir, pp, k.name, info)) { lib.kinds[k.name] = std::move(info); }
+		if (pp.failed) { lib.kinds.clear(); return lib; }
+	}
+	lib.usable = !lib.kinds.empty();
+	return lib;
+}
+
+// Whether the source names KIND<float> or KIND<float, access::sample>.
+bool usesKind(const std::string& src, const std::string& kind) {
+	std::string needle = kind + "<float";
+	for (size_t p = 0; (p = src.find(needle, p)) != std::string::npos; p += needle.size()) {
+		if (p > 0 && isIdent(src[p - 1])) { continue; }
+		size_t e = p + needle.size();
+		if (src.compare(e, 1, ">") == 0 || src.compare(e, 17, ", access::sample>") == 0) { return true; }
+	}
+	return false;
+}
+
+// Whether the source calls spvDepthCast(), as opposed to only declaring it.
+bool callsDepthCast(const std::string& src) {
+	static const char needle[] = "spvDepthCast(";
+	for (size_t p = 0; (p = src.find(needle, p)) != std::string::npos; ) {
+		p += sizeof(needle) - 1;
+		if (src.compare(p, 7, "texture") != 0) { return true; }
+	}
+	return false;
+}
+
+}	// namespace
+
+bool mvkSlimTextureClasses(const std::string& mslSource, uint32_t mslVersion, std::string& slimSource) {
+	static const char anchor[] = "using namespace metal;\n";
+	size_t insertAt = mslSource.find(anchor);
+	if (insertAt == std::string::npos) { return false; }
+	insertAt += sizeof(anchor) - 1;
+
+	const Library& lib = library(mslVersion);
+	if ( !lib.usable ) { return false; }
+
+	std::set<std::string> wanted;
+	for (auto& k : kKinds) {
+		if ( !k.depthOf && lib.kinds.count(k.name) && usesKind(mslSource, k.name) ) { wanted.insert(k.name); }
+	}
+	if (callsDepthCast(mslSource)) {
+		for (auto& k : kKinds) {
+			if (k.depthOf && lib.kinds.count(k.name) && usesKind(mslSource, k.depthOf)) { wanted.insert(k.name); }
+		}
+	}
+	for (auto& k : kKinds) {
+		if (k.depthOf && lib.kinds.count(k.name) && usesKind(mslSource, k.name)) { wanted.insert(k.name); }
+	}
+	if (wanted.empty()) { return false; }
+
+	std::string prelude =
+		"#pragma METAL internals : enable\n"
+		"namespace metal {\n"
+		"template <> struct _texture2d_sample<char, access::read, __memory_coherence_threadgroup, void>\n"
+		"{\n"
+		"  static METAL_FUNC __metal_sampler_t val(sampler s) { return s.val; }\n"
+		"};\n"
+		"using _mvkSamplerHandle = _texture2d_sample<char, access::read, __memory_coherence_threadgroup, void>;\n";
+
+	std::map<std::string, bool> called;		// method name -> whether the source calls it
+	for (auto& kindName : wanted) {
+		const KindInfo& info = lib.kinds.at(kindName);
+		std::string self = kindName + "<float, access::sample, memory_coherence_threadgroup, void>";
+		prelude += "template <> struct " + self + "\n{\n"
+			"  using T = float;\n"
+			"  static constexpr constant access a = access::sample;\n"
+			"  static constexpr constant __memory_coherence c = __memory_coherence_threadgroup;\n"
+			"  using __derived_t = " + self + ";\n"
+			"  " + info.handleType + " t;\n";
+		for (auto& m : info.methods) {
+			auto c = called.find(m.name);
+			if (c == called.end()) {
+				c = called.emplace(m.name, mslSource.find("." + m.name + "(") != std::string::npos).first;
+			}
+			if (c->second) { prelude += m.text; }
+		}
+		prelude += "};\n";
+	}
+	prelude += "}\n#pragma METAL internals : disable\n";
+
+	slimSource.clear();
+	slimSource.reserve(mslSource.size() + prelude.size());
+	slimSource.append(mslSource, 0, insertAt);
+	slimSource += prelude;
+	slimSource.append(mslSource, insertAt, std::string::npos);
+	return true;
+}
diff --git a/MoltenVK/MoltenVK/Utility/MVKSlimTextureClasses.h b/MoltenVK/MoltenVK/Utility/MVKSlimTextureClasses.h
new file mode 100644
index 00000000..4cc9c7b7
--- /dev/null
+++ b/MoltenVK/MoltenVK/Utility/MVKSlimTextureClasses.h
@@ -0,0 +1,40 @@
+/*
+ * MVKSlimTextureClasses.h
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *     http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+#pragma once
+
+#include <string>
+
+/**
+ * The Metal compiler instantiates every member of a texture class the first time MSL source
+ * names the type: 409 member functions for texture2d<float> at MSL 4.0, about 40 ms per distinct
+ * type per library, whatever the shader calls. This pass gives the source its own explicit
+ * specialization of each sampled float texture and depth class it uses, holding only the methods
+ * it calls, so the compiler has almost nothing to instantiate. The method bodies are read from the
+ * Metal standard library headers installed with the compiler, so they are the ones the compiler
+ * would have used, and the generated GPU code is the same.
+ *
+ * Returns true and sets slimSource when at least one class was replaced. Returns false, leaving
+ * slimSource untouched, when the source uses no class this covers, when the headers cannot be read
+ * or are not in the expected shape, or for an MSL version before 3.2.
+ *
+ * The specializations rely on the standard library's internal names. A source that does not
+ * compile with them must be compiled again as it was.
+ *
+ * mslVersion is major * 100 + minor * 10, as __METAL_VERSION__ (400 for MSL 4.0).
+ * Thread-safe.
+ */
+bool mvkSlimTextureClasses(const std::string& mslSource, uint32_t mslVersion, std::string& slimSource);
diff --git a/MoltenVK/MoltenVK/Vulkan/mvk_datatypes.hpp b/MoltenVK/MoltenVK/Vulkan/mvk_datatypes.hpp
index 99460bef..d1baa30a 100644
--- a/MoltenVK/MoltenVK/Vulkan/mvk_datatypes.hpp
+++ b/MoltenVK/MoltenVK/Vulkan/mvk_datatypes.hpp
@@ -77,6 +77,12 @@ MTLMultisampleStencilResolveFilter mvkMTLMultisampleStencilResolveFilterFromVkRe
 MVKShaderStage mvkShaderStageFromVkShaderStageFlagBitsInObj(VkShaderStageFlagBits vkStage, MVKBaseObject* mvkObj);
 #define mvkShaderStageFromVkShaderStageFlagBits(vkStage) mvkShaderStageFromVkShaderStageFlagBitsInObj(vkStage, this)
 
+/** returns the Vulkan stages using this stage's resources. mesh pipelines have no vertex or tessellation shaders, so mesh and task shaders take those slots */
+static inline VkShaderStageFlags mvkVkShaderStagesFromMVKShaderStage(MVKShaderStage stage) {
+	VkShaderStageFlags alias = stage == kMVKShaderStageVertex ? VK_SHADER_STAGE_MESH_BIT_EXT : stage == kMVKShaderStageTessCtl ? VK_SHADER_STAGE_TASK_BIT_EXT : 0;
+	return mvkVkShaderStageFlagBitsFromMVKShaderStage(stage) | alias;

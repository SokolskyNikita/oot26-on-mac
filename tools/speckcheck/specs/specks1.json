[
 {
  "label": "specks-capture",
  "app": "${REPO}/build/old-trees/path-60/app-practice/lichii.app",
  "phase_frames": 600,
  "desc": "White specks at the cave wall: bursts, shader list and a full frame capture there (practice app)",
  "at_end": [
   {
    "burst": 40,
    "name": "before"
   },
   {
    "call": "status",
    "save": "status"
   },
   {
    "call": "capture_frame",
    "params": {
     "sampled": true,
     "timeout_s": 300
    },
    "timeout": 360,
    "save": "capture"
   },
   {
    "frames": 120
   },
   {
    "burst": 10,
    "name": "after"
   }
  ]
 },
 {
  "label": "specks-all-emulated",
  "app": "${REPO}/build/old-trees/path-60/app-practice/lichii.app",
  "phase_frames": 600,
  "env": {
   "EDEN_NX2_FORCE_MESH_FALLBACK": 1
  },
  "desc": "White specks at the cave wall with every mesh shader emulated (no native mesh): gone?",
  "at_end": [
   {
    "burst": 40,
    "name": "before"
   }
  ]
 }
]
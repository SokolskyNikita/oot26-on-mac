diff --git a/tools/nx2/macos_sample.py b/tools/nx2/macos_sample.py
new file mode 100644
index 0000000000..5ead1c90e3
--- /dev/null
+++ b/tools/nx2/macos_sample.py
@@ -0,0 +1,154 @@
+#!/usr/bin/env python3
+# SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+# SPDX-License-Identifier: GPL-3.0-or-later
+
+"""Where a running lichii spends its time on macOS, per thread.
+
+Samples the process with /usr/bin/sample and prints, for each thread, how busy it was and the
+functions it was in most. A thread near 100 % is what the frame waits for.
+
+usage: python3 -I tools/nx2/macos_sample.py [--seconds 10] [--pid PID] [--top 6] [--waits 3] [--keep FILE]
+"""
+
+import argparse
+import collections
+import re
+import subprocess
+import sys
+import tempfile
+
+# Leaves that mean the thread is waiting, not working.
+IDLE = {
+    "mach_msg2_trap", "mach_msg_trap", "__psynch_cvwait", "__psynch_mutexwait",
+    "semaphore_wait_trap", "semaphore_timedwait_trap", "semaphore_wait_signal_trap", "__ulock_wait", "__ulock_wait2",
+    "kevent", "kevent64", "kevent_id", "__select", "__semwait_signal", "nanosleep", "poll",
+    "read", "__workq_kernreturn", "__sigwait", "start_wqthread", "__accept", "__recvfrom",
+}
+# Leaves that are the guest's own code.
+GUEST = {"hv_vcpu_run", "hv_trap", "???"}
+
+LINE = re.compile(r"^([ +!:|]*)(\d+) (.*)$")
+OURS = re.compile(r"^(Vulkan|VideoCommon|VideoCore|Tegra|Core|Kernel|Service|AudioCore|Common|"
+                  r"FileSys|MVK|mvk|vk[A-Z]|-\[MVK|-\[MTL|AGX)")
+THREAD = re.compile(r"^Thread_\w+(?::?\s+(.*))?$")
+
+
+def symbol(text):
+    name = text.split("  (in ")[0].strip()
+    return re.sub(r"\s+\[0x[0-9a-f,]+\]$", "", name)
+
+
+def parse(report):
+    """Returns [(thread name, total samples, {leaf: samples}, {waiting function: samples})]."""
+    threads = []
+    lines = report.splitlines()
+    try:
+        start = next(i for i, line in enumerate(lines) if line.startswith("Call graph:")) + 1
+    except StopIteration:
+        return threads
+    stack = []  # (depth, count, children total, symbol)
+    leaves = waits = None
+
+    def close(depth):
+        while stack and stack[-1][0] >= depth:
+            _, count, children, name = stack.pop()
+            if count > children:
+                leaves[name] += count - children
+                if name in IDLE:
+                    # The emulator's function that waits, not the library's primitive.
+                    waiter = next((frame[3] for frame in reversed(stack) if OURS.match(frame[3])),
+                                  name)
+                    waits[waiter] += count - children
+
+    for line in lines[start:]:
+        match = LINE.match(line)
+        if not match:
+            if stack:
+                close(0)
+            if line.strip() == "" or line.startswith("Total number"):
+                if line.startswith("Total number"):
+                    break
+            continue
+        depth, count, text = len(match.group(1)), int(match.group(2)), match.group(3)
+        thread = THREAD.match(text.split("   ")[0].strip()) if depth <= 4 else None
+        if thread and text.startswith("Thread_"):
+            if stack:
+                close(0)
+            leaves, waits = collections.Counter(), collections.Counter()
+            name = (thread.group(1) or "").strip() or text.split()[0]
+            name = re.sub(r"^DispatchQueue_\d+:\s*", "", name)
+            threads.append((name, count, leaves, waits))
+            continue
+        if leaves is None:
+            continue
+        close(depth)
+        if stack:
+            parent = stack[-1]
+            stack[-1] = (parent[0], parent[1], parent[2] + count, parent[3])
+        stack.append((depth, count, 0, symbol(text)))
+    if stack:
+        close(0)
+    return threads
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
+    parser.add_argument("--seconds", type=int, default=10)
+    parser.add_argument("--pid", type=int)
+    parser.add_argument("--top", type=int, default=6, help="functions listed per thread")
+    parser.add_argument("--waits", type=int, default=3, help="waiting functions listed per thread")
+    parser.add_argument("--keep", help="also write sample's full report to this file")
+    parser.add_argument("--report", help="parse an existing sample report instead of sampling")
+    args = parser.parse_args()
+
+    if args.report:
+        report = open(args.report, errors="replace").read()
+    else:
+        pid = args.pid
+        if pid is None:
+            found = subprocess.run(["pgrep", "-f", "MacOS/lichii|eden-cli|lichii-cmd"], capture_output=True,
+                                   text=True).stdout.split()
+            if not found:
+                sys.exit("lichii is not running; start a game first")
+            pid = int(found[0])
+        with tempfile.NamedTemporaryFile(suffix=".txt") as out:
+            subprocess.run(["sample", str(pid), str(args.seconds), "-file", out.name],
+                           check=True, capture_output=True)
+            report = open(out.name, errors="replace").read()
+        if args.keep:
+            open(args.keep, "w").write(report)
+
+    rows = []
+    threads = parse(report)
+    longest = max((thread[1] for thread in threads), default=0)
+    for name, total, leaves, waits in threads:
+        # Threads that lived for a few samples only say nothing.
+        if total * 20 < longest:
+            continue
+        idle = sum(count for leaf, count in leaves.items() if leaf in IDLE)
+        cpu_thread = name.startswith(("CPUCore", "CPUThread"))
+        guest = sum(count for leaf, count in leaves.items()
+                    if leaf in GUEST) if cpu_thread else 0
+        rows.append((100.0 * (total - idle) / total, 100.0 * guest / total, name, total, leaves,
+                     waits))
+    rows.sort(key=lambda row: -row[0])
+
+    print(f"{'busy':>6} {'guest':>6}  thread")
+    for busy, guest, name, total, leaves, waits in rows:
+        if busy < 1.0:
+            continue
+        print(f"{busy:5.1f}% {guest:5.1f}%  {name}")
+        show_guest_functions = name.startswith("CPUThread")
+        work = [(count, leaf) for leaf, count in leaves.items()
+                if leaf not in IDLE and (leaf not in GUEST or show_guest_functions)]
+        for count, leaf in sorted(work, reverse=True)[:args.top]:
+            print(f"{'':16}{100.0 * count / total:5.1f}%  {leaf[:100]}")
+        for waiter, count in waits.most_common(args.waits):
+            print(f"{'':10}waits {100.0 * count / total:5.1f}%  {waiter[:100]}")
+    quiet = sum(1 for row in rows if row[0] < 1.0)
+    print(f"\n{quiet} threads under 1 % not shown. busy: share of the samples the thread was not "
+          "waiting; guest: share spent in the game's own code; waits: where it waited.")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/tools/nx2/test_macos_sample.py b/tools/nx2/test_macos_sample.py
new file mode 100644
index 0000000000..dc73b26dd4
--- /dev/null
+++ b/tools/nx2/test_macos_sample.py
@@ -0,0 +1,40 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-3.0-or-later
+
+import os
+import subprocess
+import sys
+import tempfile
+import unittest
+
+SCRIPT = os.path.join(os.path.dirname(os.path.abspath(__file__)), "macos_sample.py")
+REPORT = """\
+Call graph:
+  100 Thread_0: CPUCore 0
+    100 hv_vcpu_run
+  100 Thread_1: CPUThread
+    100 hv_vcpu_run
+Total number in stack (200 samples)
+"""
+
+
+class MacosSampleTest(unittest.TestCase):
+    def test_guest_accounting_for_both_cpu_thread_names(self):
+        with tempfile.NamedTemporaryFile(mode="w", encoding="utf-8") as report:
+            report.write(REPORT)
+            report.flush()
+            result = subprocess.run(
+                [sys.executable, "-I", SCRIPT, "--report", report.name],
+                capture_output=True,
+                text=True,
+                check=True,
+            )
+
+        self.assertIn("100.0%  CPUCore 0", result.stdout)
+        self.assertIn("100.0%  CPUThread", result.stdout)
+        cpu_thread_section = result.stdout.split("CPUThread", 1)[1]
+        self.assertIn("100.0%  hv_vcpu_run", cpu_thread_section)
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/tools/package-macos.sh b/tools/package-macos.sh
new file mode 100755
index 0000000000..4a38286f50
--- /dev/null
+++ b/tools/package-macos.sh
@@ -0,0 +1,168 @@
+#!/bin/bash -e
+
+# SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+# SPDX-License-Identifier: GPL-3.0-or-later
+
+# Builds lichii and makes a self-contained copy of the app, as the release workflow does:
+# Qt and the Homebrew libraries go inside the bundle, so it runs on a Mac without them.
+# usage: tools/package-macos.sh [build dir (build/release)] [output dir (build/package)]
+
+set -o pipefail
+
+cd "$(dirname "$0")/.."
+build=${1:-build/release}
+out=${2:-build/package}
+app="$out/lichii.app"
+
+cmake --build "$build"
+
+# The build's own app stays as it is: a later build relinks it against Homebrew.
+rm -rf "$app"
+mkdir -p "$out"
+cp -R "$build/bin/lichii.app" "$app"
+cp "$build/bin/eden-cli" "$app/Contents/MacOS/eden-cli"
+
+macdeployqt "$app" -executable="$app/Contents/MacOS/eden-cli" -libpath="$(brew --prefix)/lib" \
+    -always-overwrite -verbose=1
+# Qt's virtual keyboard input plugin pulls in the QML stack, which the emulator doesn't use.
+rm -f "$app/Contents/PlugIns/platforminputcontexts/libqtvirtualkeyboardplugin.dylib"
+
+# With Homebrew's split Qt packages macdeployqt copies plugins whose own frameworks (QtSvg, QtPdf)
+# it can't find. The emulator uses none of them: a plugin with a dependency missing from the
+# bundle is dropped rather than left to fail on another Mac.
+unresolved() {
+    local dependencies line name
+    if ! dependencies=$(otool -L "$1"); then
+        echo "Failed to inspect dependencies for $1" >&2
+        return 1
+    fi
+    while IFS= read -r line; do
+        if [[ "$line" =~ ^[[:space:]]+(@rpath/[^[:space:]]+) ]]; then
+            name=${BASH_REMATCH[1]}
+            if [ ! -e "$app/Contents/Frameworks/${name#@rpath/}" ]; then
+                printf '%s\n' "$name"
+            fi
+        fi
+    done <<< "$dependencies"
+}
+
+candidate_file=$(mktemp)
+trap 'rm -f "$candidate_file"' EXIT
+if ! find "$app/Contents/PlugIns" -name '*.dylib' -print0 > "$candidate_file"; then
+    echo "Failed to list app plugins" >&2
+    exit 1
+fi
+while IFS= read -r -d '' plugin; do
+    if ! missing=$(unresolved "$plugin"); then
+        exit 1
+    fi
+    if [ -n "$missing" ]; then
+        echo "Dropping ${plugin#"$app"/}: needs ${missing//$'\n'/ }"
+        rm -f "$plugin"
+    fi
+done < "$candidate_file"
+
+if ! find "$app/Contents" -type f \( -perm -u+x -o -name '*.dylib' \) -print0 \
+    > "$candidate_file"; then
+    echo "Failed to list app binaries" >&2
+    exit 1
+fi
+binaries=()
+while IFS= read -r -d '' candidate; do
+    if ! description=$(file -b "$candidate"); then
+        echo "Failed to identify binary type for $candidate" >&2
+        exit 1
+    fi
+    case "$description" in
+        *Mach-O*) binaries+=("$candidate") ;;
+    esac
+done < "$candidate_file"
+
+remove_nonbundle_rpaths() {
+    local binary="$1" load_commands rpaths rpath
+    if ! load_commands=$(otool -l "$binary"); then
+        echo "Failed to inspect rpaths for $binary" >&2
+        return 1
+    fi
+    if ! rpaths=$(awk '/cmd LC_RPATH/ {getline; getline; print $2}' <<< "$load_commands"); then
+        echo "Failed to parse rpaths for $binary" >&2
+        return 1
+    fi
+    while IFS= read -r rpath; do
+        case "$rpath" in
+            /opt/homebrew/* | /usr/local/* | "$PWD"/*)
+                install_name_tool -delete_rpath "$rpath" "$binary" 2>/dev/null || return 1
+                ;;
+        esac
+    done <<< "$rpaths"
+}
+
+for binary in "${binaries[@]}"; do
+    remove_nonbundle_rpaths "$binary"
+done
+# Libraries that load their dependencies through @rpath find them in the bundle.
+for program in lichii eden-cli; do
+    install_name_tool -add_rpath @executable_path/../Frameworks \
+        "$app/Contents/MacOS/$program" 2> /dev/null || true
+done
+
+# macdeployqt invalidates the signatures, and the Hypervisor CPU backend needs its entitlement.
+codesign --force --deep --sign - "$app"
+codesign --force --sign - --entitlements dist/eglantine.entitlements "$app/Contents/MacOS/eden-cli"
+codesign --force --sign - --entitlements dist/eglantine.entitlements "$app"
+codesign --verify --deep --strict "$app"
+
+inspect_binary() {
+    local binary="$1" dependencies load_commands rpaths rpath missing line first
+    if ! dependencies=$(otool -L "$binary"); then
+        echo "Failed to inspect linked libraries for $binary" >&2
+        return 1
+    fi
+    first=1
+    while IFS= read -r line; do
+        if [ "$first" -eq 1 ]; then
+            first=0
+            continue
+        fi
+        case "$line" in
+            *"/usr/lib/libhvf.dylib"*)
+                echo "::error::$binary links /usr/lib/libhvf.dylib, unavailable on macOS 15.0 to 15.3" >&2
+                return 1
+                ;;
+            *"/opt/homebrew/"* | *"/usr/local/"* | *"$PWD/"*)
+                echo "Reference outside the app bundle in $binary: $line" >&2
+                return 1
+                ;;
+        esac
+    done <<< "$dependencies"
+    if ! load_commands=$(otool -l "$binary"); then
+        echo "Failed to inspect load commands for $binary" >&2
+        return 1
+    fi
+    if ! rpaths=$(awk '/cmd LC_RPATH/ {getline; getline; print $2}' <<< "$load_commands"); then
+        echo "Failed to parse rpaths for $binary" >&2
+        return 1
+    fi
+    while IFS= read -r rpath; do
+        case "$rpath" in
+            /opt/homebrew/* | /usr/local/* | "$PWD"/*)
+                echo "Rpath outside the app bundle in $binary: $rpath" >&2
+                return 1
+                ;;
+        esac
+    done <<< "$rpaths"
+    if ! missing=$(unresolved "$binary"); then
+        return 1
+    fi
+    if [ -n "$missing" ]; then
+        echo "Dependencies missing from the app bundle for $binary: ${missing//$'\n'/ }" >&2
+        return 1
+    fi
+}
+
+for binary in "${binaries[@]}"; do
+    inspect_binary "$binary"
+done
+
+ditto -c -k --keepParent "$app" "$out/lichii-macos-arm64.zip"
+echo "Packaged $app and $out/lichii-macos-arm64.zip"
diff --git a/src/dynarmic/src/dynarmic/backend/arm64/block_table.h b/src/dynarmic/src/dynarmic/backend/arm64/block_table.h
new file mode 100644
index 0000000000..41a85814b5
--- /dev/null
+++ b/src/dynarmic/src/dynarmic/backend/arm64/block_table.h
@@ -0,0 +1,161 @@
+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#pragma once
+
+#include <atomic>
+#include <cstddef>
+#include <memory>
+#include <vector>
+
+#include "common/common_types.h"
+
+namespace Dynarmic::Backend::Arm64 {
+
+using CodePtr = std::byte*;
+
+/// The code cache's map from a block's location descriptor to its entry point. Any thread may call Find at any
+/// time, without a lock: the dispatcher of every Jit of a shared cache does, and with one lock around the map those
+/// lookups waited behind every block being emitted (about 7 s per game load, summed over six cores). Everything
+/// else needs the caller to hold the cache's lock exclusively.
+///
+/// An open-addressing table of atomic slots. A key, once written, stays in its slot: dropping a block clears the
+/// slot's entry point, and the block compiled for the same location later takes the slot again. A full table is
+/// replaced by a larger copy; the old one is kept, because a Find may still be walking it. Such a Find can miss a
+/// block inserted since, or return one dropped since, exactly as a Find that ran a moment earlier would have.
+class BlockTable {
+public:
+    BlockTable() {
+        Publish(std::make_unique<Table>(initial_capacity));
+    }
+
+    CodePtr Find(u64 key) const {
+        const Table& table = *current.load(std::memory_order_acquire);
+        for (std::size_t index = Hash(key) & table.mask;; index = (index + 1) & table.mask) {
+            const Slot& slot = table.slots[index];
+            const u64 slot_key = slot.key.load(std::memory_order_acquire);
+            if (slot_key == key) {
+                return slot.entry_point.load(std::memory_order_acquire);
+            }
+            if (slot_key == empty_key) {
+                return nullptr;
+            }
+        }
+    }
+
+    /// False if the key has an entry point already.
+    bool Insert(u64 key, CodePtr entry_point) {
+        if ((keys + 1) * 5 > Capacity() * 3) {
+            Grow();
+        }
+        Table& table = *current.load(std::memory_order_relaxed);
+        for (std::size_t index = Hash(key) & table.mask;; index = (index + 1) & table.mask) {
+            Slot& slot = table.slots[index];
+            const u64 slot_key = slot.key.load(std::memory_order_relaxed);
+            if (slot_key == key) {
+                if (slot.entry_point.load(std::memory_order_relaxed) != nullptr) {
+                    return false;
+                }
+                slot.entry_point.store(entry_point, std::memory_order_release);
+                return true;
+            }
+            if (slot_key == empty_key) {
+                // The entry point first: a Find that sees the key then sees it too.
+                slot.entry_point.store(entry_point, std::memory_order_release);
+                slot.key.store(key, std::memory_order_release);
+                ++keys;
+                return true;
+            }
+        }
+    }
+
+    /// The entry point the key had, or nullptr.
+    CodePtr Erase(u64 key) {
+        Table& table = *current.load(std::memory_order_relaxed);
+        for (std::size_t index = Hash(key) & table.mask;; index = (index + 1) & table.mask) {
+            Slot& slot = table.slots[index];
+            const u64 slot_key = slot.key.load(std::memory_order_relaxed);
+            if (slot_key == key) {
+                return slot.entry_point.exchange(nullptr, std::memory_order_acq_rel);
+            }
+            if (slot_key == empty_key) {
+                return nullptr;
+            }
+        }
+    }
+
+    /// Forgets every block. No Find may run meanwhile: the cache is cleared only when no Jit runs its code.
+    void Clear() {
+        Table& table = *current.load(std::memory_order_relaxed);
+        for (std::size_t index = 0; index <= table.mask; ++index) {
+            table.slots[index].key.store(empty_key, std::memory_order_relaxed);
+            table.slots[index].entry_point.store(nullptr, std::memory_order_relaxed);
+        }
+        keys = 0;
+        // Tables replaced before this clear: nothing can still be walking them.
+        if (tables.size() > 1) {
+            tables.erase(tables.begin(), tables.end() - 1);
+        }
+    }
+
+private:
+    struct Slot {
+        std::atomic<u64> key{empty_key};
+        std::atomic<CodePtr> entry_point{nullptr};
+    };
+    struct Table {
+        explicit Table(std::size_t capacity)
+                : mask{capacity - 1}, slots{std::make_unique<Slot[]>(capacity)} {}
+        std::size_t mask;
+        std::unique_ptr<Slot[]> slots;
+    };
+
+    /// No location descriptor has this value (the Jits' own lookup tables use it the same way).
+    static constexpr u64 empty_key = ~u64{0};
+    static constexpr std::size_t initial_capacity = std::size_t{1} << 16;
+
+    static std::size_t Hash(u64 key) {
+        key ^= key >> 33;
+        key *= 0xff51afd7ed558ccdULL;
+        key ^= key >> 33;
+        return static_cast<std::size_t>(key);
+    }
+
+    std::size_t Capacity() const {
+        return current.load(std::memory_order_relaxed)->mask + 1;
+    }
+
+    void Publish(std::unique_ptr<Table> table) {
+        current.store(table.get(), std::memory_order_release);
+        tables.push_back(std::move(table));
+    }
+
+    /// Copies the blocks that still have an entry point into a table of twice the size.
+    void Grow() {
+        const Table& old = *current.load(std::memory_order_relaxed);
+        auto table = std::make_unique<Table>((old.mask + 1) * 2);
+        std::size_t kept = 0;
+        for (std::size_t index = 0; index <= old.mask; ++index) {
+            const u64 key = old.slots[index].key.load(std::memory_order_relaxed);
+            const CodePtr entry_point = old.slots[index].entry_point.load(std::memory_order_relaxed);
+            if (key == empty_key || entry_point == nullptr) {
+                continue;
+            }
+            std::size_t to = Hash(key) & table->mask;
+            while (table->slots[to].key.load(std::memory_order_relaxed) != empty_key) {
+                to = (to + 1) & table->mask;
+            }
+            table->slots[to].entry_point.store(entry_point, std::memory_order_relaxed);
+            table->slots[to].key.store(key, std::memory_order_relaxed);
+            ++kept;
+        }
+        keys = kept;
+        Publish(std::move(table));
+    }
+
+    std::atomic<Table*> current{nullptr};
+    std::vector<std::unique_ptr<Table>> tables;  ///< The last one is `current`
+    std::size_t keys = 0;  ///< Slots of `current` with a key
+};
+
+}  // namespace Dynarmic::Backend::Arm64
